#!/bin/bash
#
# maze-kernel-helper — privileged backend for the Maze Kernel Switcher GUI.
#
# SECURITY MODEL
# --------------
# The GUI (maze-kernel) never touches the system directly: it invokes this
# helper through pkexec, so the graphical polkit prompt is the single point of
# authorisation. We ship NO polkit .policy for it — pkexec therefore applies its
# default org.freedesktop.policykit.exec action (auth_admin), i.e. an
# administrator password is always required. There is deliberately no
# passwordless / allow_active rule, so this is never a silent privilege-
# escalation path.
#
# Because it runs as root, the input surface is kept minimal and fully
# constrained:
#   * exactly one verb (matched by a case statement) and at most one operand;
#   * the operand must be one of a fixed CATALOG of kernel package bases — an
#     attacker cannot coax this into touching an arbitrary package;
#   * a fixed interpreter (/bin/bash) and a fixed, minimal PATH, so neither the
#     shebang lookup nor any called tool can be hijacked via the environment
#     (pkexec already scrubs the environment; this is defence in depth);
#   * every expansion is quoted and nothing is eval'd or sourced.
#
# Maze installs kernels as signed UKIs via systemd's kernel-install (layout=uki)
# plus a pacman hook, so a freshly installed kernel is built and
# Secure-Boot-signed automatically by the existing hooks — this helper only
# drives pacman and the boot-default pin (/etc/maze/kernel-default); the boot
# image itself is always written by maze-sb-sign.
set -euo pipefail
export PATH=/usr/bin
IFS=$' \t\n'
umask 022

# The kernels the switcher offers. Kept in lockstep with maze-kernel's catalog.
readonly -a CATALOG=(linux linux-lts linux-zen linux-hardened)

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

is_known() {
    local k
    for k in "${CATALOG[@]}"; do [ "$k" = "$1" ] && return 0; done
    return 1
}

running_pkgbase() {
    cat "/usr/lib/modules/$(uname -r)/pkgbase" 2>/dev/null || true
}

# The uname-style version directory for an installed pkgbase (empty if absent).
# This is exactly the string kernel-install embeds in the UKI file name, so it
# is what we match boot entries against. Same rule as maze-sb-sign's
# kver_for_pkgbase: a directory without a vmlinuz is a leftover, not a kernel.
kver_for() {
    local f d
    for f in /usr/lib/modules/*/pkgbase; do
        [ -r "$f" ] || continue
        [ "$(cat "$f")" = "$1" ] || continue
        d="${f%/pkgbase}"
        [ -f "$d/vmlinuz" ] || continue
        printf '%s\n' "${d##*/}"
        return 0
    done
    return 1
}

# Newest installed kernel version — maze-sb-sign's choice when nothing is pinned.
newest_kver() {
    local d
    for d in /usr/lib/modules/*/; do
        [ -f "${d}vmlinuz" ] || continue
        d="${d%/}"
        printf '%s\n' "${d##*/}"
    done | sort -V | tail -n1
}

find_esp() {
    local esp
    esp="$(bootctl --print-esp-path 2>/dev/null || true)"
    [ -n "$esp" ] && [ -d "$esp" ] || esp=/efi
    [ -d "$esp" ] || esp=/boot
    printf '%s\n' "$esp"
}

# The kernel-install UKI for a version: by file name first, then by the PE
# .uname section (custom entry_token). Mirrors maze-sb-sign's find_uki, so we
# only accept a kernel that the signer will also be able to find.
find_uki() {
    local f u
    for f in "$ESP"/EFI/Linux/*"$1".efi; do
        [ -f "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    command -v objcopy >/dev/null 2>&1 || return 1
    for f in "$ESP"/EFI/Linux/*.efi; do
        [ -f "$f" ] || continue
        u="$(objcopy -O binary --only-section=.uname "$f" /dev/stdout 2>/dev/null \
                | tr -d '\0' | tr -d '[:space:]')"
        [ "$u" = "$1" ] && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}

# The kernel version grubx64.efi holds right now, per maze-sb-sign's marker.
grub_kver() {
    tr -d '[:space:]' 2>/dev/null < "$ESP/EFI/BOOT/grubx64.efi.maze-kver" || true
}

KEYDIR=/var/lib/maze-secureboot
DEFAULT_MARKER=/etc/maze/kernel-default

have_mok() { [ -r "$KEYDIR/MOK.key" ] && [ -r "$KEYDIR/MOK.crt" ]; }

write_pin() {  # write_pin <pkgbase> — empty removes the pin
    if [ -n "$1" ]; then
        mkdir -p /etc/maze
        printf '%s\n' "$1" > "$DEFAULT_MARKER.new"
        chmod 644 "$DEFAULT_MARKER.new"
        mv -f "$DEFAULT_MARKER.new" "$DEFAULT_MARKER"
    else
        rm -f "$DEFAULT_MARKER"
    fi
}

# No-MOK fallback only (Secure Boot off and no machine key, so maze-sb-sign
# skips everything). Installs <uki> as grubx64.efi under maze-sb-sign's own
# lock so the two can never interleave writes to the one file shim boots.
plain_install() {  # plain_install <uki> <kver>
    # Runs inside `if !`, where set -e is off: every step is checked by hand.
    local grub="$ESP/EFI/BOOT/grubx64.efi" tmp="$ESP/EFI/BOOT/.grubx64.maze-new" prev
    mkdir -p /run/lock
    exec 9>/run/lock/maze-sb-sign.lock || return 1
    flock 9 || return 1
    prev="$(grub_kver)"
    if [ -s "$grub" ] && [ -n "$prev" ] && [ "$prev" != "$2" ] \
       && [ -f "/usr/lib/modules/$prev/vmlinuz" ]; then
        { cp -f "$grub" "$grub.maze-prev" && printf '%s\n' "$prev" > "$grub.maze-prev.kver"; } \
            || rm -f "$grub.maze-prev" "$grub.maze-prev.kver"
    fi
    if ! { cp -f "$1" "$tmp" && sync && mv -f "$tmp" "$grub"; }; then
        rm -f "$tmp"
        exec 9>&-
        return 1
    fi
    printf '%s\n' "$2" > "$grub.maze-kver"
    sha256sum "$1" | cut -d' ' -f1 > "$grub.maze-src"
    sync
    exec 9>&-
}

# Make grubx64.efi match the current pin (or the newest kernel when unpinned)
# and confirm it now holds <kver>. Returns non-zero when it does not.
apply_boot_default() {  # apply_boot_default <kver> <uki>
    if have_mok; then
        command -v maze-sb-sign >/dev/null 2>&1 \
            || die "maze-sb-sign is missing — reinstall maze-secureboot."
        # maze-sb-sign owns the boot image: it takes the signer lock, signs,
        # keeps the rollback copy, writes every marker and refreshes the
        # recovery entry. Doing any of that here too is how the two drifted.
        maze-sb-sign --force-bootloader || \
            echo ">> WARNING: maze-sb-sign reported a problem (see above)." >&2
    else
        secure_boot_enabled && \
            die "Secure Boot is on but this machine's MOK key ($KEYDIR/MOK.key) is missing — cannot produce a signed boot image. Nothing was changed."
        echo ">> No Maze signing key and Secure Boot is off — installing the image unsigned."
        plain_install "$2" "$1"
    fi
    [ "$(grub_kver)" = "$1" ]
}

# nvidia-utils blacklists nouveau, so a kernel without a built nvidia module
# boots to a black screen. maze-sb-sign would silently route around such a pin;
# refusing it here is clearer than a default that is not what actually boots.
nvidia_ok() {  # nvidia_ok <kver>
    [ -f /usr/lib/modprobe.d/nvidia-utils.conf ] || return 0
    modinfo -k "$1" -n nvidia >/dev/null 2>&1
}

# Is UEFI Secure Boot currently ENFORCING? Prefer mokutil (what Maze installs),
# then bootctl, then the raw EFI variable (last data byte: 1 = on). Returns 0
# (true) only when Secure Boot is definitely enabled.
secure_boot_enabled() {
    if command -v mokutil >/dev/null 2>&1; then
        mokutil --sb-state 2>/dev/null | grep -qiE 'secureboot[[:space:]]+enabled'
        return
    fi
    if command -v bootctl >/dev/null 2>&1 \
       && bootctl status 2>/dev/null | grep -qiE 'secure boot:[[:space:]]*enabled'; then
        return 0
    fi
    local b
    b="$(cat /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | tail -c1 \
         | od -An -tu1 2>/dev/null | tr -d ' ')"
    [ "$b" = "1" ]
}

usage() { die "usage: maze-kernel-helper {install|remove|set-default} <pkgbase> | clear-default"; }

[ "$(id -u)" -eq 0 ] || die "maze-kernel-helper must run as root (via pkexec)."

cmd="${1:-}"
pkg=""
if [ "$cmd" = "clear-default" ]; then
    [ "$#" -eq 1 ] || usage
else
    [ "$#" -eq 2 ] || usage
    pkg="$2"
    is_known "$pkg" || die "unknown kernel '$pkg'."
fi
ESP="$(find_esp)"

case "$cmd" in
    install)
        echo ">> Updating the system and installing ${pkg} + ${pkg}-headers"
        echo ">> (a full sync avoids partial-upgrade breakage; the kernel-install"
        echo ">>  hook then builds and Secure-Boot-signs the boot image for you)"
        echo
        # -Syu (not -Sy): installing a kernel onto a partially-updated rolling
        # system is the classic way to break it, so we upgrade first, atomically.
        # stdbuf -oL: pacman block-buffers stdout when it is a pipe (not a tty),
        # so force line buffering or the GUI log would only update in chunks.
        stdbuf -oL -eL pacman -Syu --needed --noconfirm -- "$pkg" "${pkg}-headers"
        echo
        echo ">> Done. '${pkg}' is installed and ready to boot."
        ;;

    remove)
        [ "$pkg" = "linux" ] && \
            die "the base 'linux' kernel is kept as a safety fallback and cannot be removed here."
        [ "$pkg" = "$(running_pkgbase)" ] && \
            die "'$pkg' is the kernel you are running right now — reboot into another kernel first."
        echo ">> Removing ${pkg} + ${pkg}-headers"
        echo
        # -Rns removes the kernel, its headers and now-orphaned deps. pacman
        # still refuses if another package needs them, so this cannot break deps.
        if pacman -Qq -- "${pkg}-headers" >/dev/null 2>&1; then
            stdbuf -oL -eL pacman -Rns --noconfirm -- "$pkg" "${pkg}-headers"
        else
            stdbuf -oL -eL pacman -Rns --noconfirm -- "$pkg"
        fi
        echo ">> Done. '${pkg}' has been removed."
        # zz-maze-secureboot.hook already re-ran maze-sb-sign inside that
        # transaction (it triggers on Remove), and a pin naming a kernel that is
        # gone falls back to the newest. Drop such a pin anyway so the switcher
        # and the signer agree, and re-run the signer if grubx64.efi still
        # names a kernel that no longer exists (hook failed or was skipped).
        if [ -r "$DEFAULT_MARKER" ] \
           && [ "$(tr -d '[:space:]' < "$DEFAULT_MARKER")" = "$pkg" ]; then
            write_pin ""
            echo ">> '${pkg}' was the pinned boot default; the pin has been cleared."
        fi
        gk="$(grub_kver)"
        if [ -n "$gk" ] && [ ! -f "/usr/lib/modules/$gk/vmlinuz" ] \
           && have_mok && command -v maze-sb-sign >/dev/null 2>&1; then
            echo ">> The boot image still points at the removed kernel — re-pointing it…"
            maze-sb-sign --force-bootloader || \
                echo ">> WARNING: re-signing failed — run 'sudo maze-boot-check --repair' BEFORE rebooting." >&2
        fi
        ;;

    set-default)
        # Maze does NOT boot through a systemd-boot menu: the chain is
        # firmware -> shim (\EFI\BOOT\BOOTX64.EFI) -> grubx64.efi, and grubx64.efi
        # IS the (MOK-signed) Unified Kernel Image of the default kernel, chosen
        # by maze-sb-sign from /etc/maze/kernel-default. So choosing a default is:
        # check the kernel can actually boot, write the pin, have maze-sb-sign
        # install it, and verify that it did — restoring the old pin if not.
        kver="$(kver_for "$pkg")" || die "'$pkg' is not installed."
        echo ">> Selecting '${pkg}' (${kver}) as the default boot kernel"
        [ -d "$ESP/EFI/BOOT" ] || \
            die "shim directory $ESP/EFI/BOOT not found — unexpected boot layout, aborting to stay safe."
        uki="$(find_uki "$kver")" || \
            die "no boot image for '$pkg' under $ESP/EFI/Linux. Rebuild it with: sudo kernel-install add $kver /usr/lib/modules/$kver/vmlinuz"
        echo ">> Boot image: $uki"
        nvidia_ok "$kver" || \
            die "the NVIDIA driver is not built for ${kver} (nouveau is blacklisted, so this kernel would boot to a black screen). Install 'nvidia-open-dkms' (or run maze-gpu-driver) and try again."

        old_pin="$(tr -d '[:space:]' 2>/dev/null < "$DEFAULT_MARKER" || true)"
        write_pin "$pkg"
        if ! apply_boot_default "$kver" "$uki"; then
            write_pin "$old_pin"
            die "the boot image was not switched to ${kver} (it holds '$(grub_kver)'). Your previous default is unchanged."
        fi

        echo
        echo ">> Done. '${pkg}' will boot by default from now on, including after"
        echo ">> kernel updates. If it is ever uninstalled, the newest kernel takes over."
        ;;

    clear-default)
        # Back to automatic: maze-sb-sign boots the newest installed kernel.
        kver="$(newest_kver)"
        [ -n "$kver" ] || die "no installed kernel found under /usr/lib/modules."
        uki="$(find_uki "$kver")" || \
            die "no boot image for the newest kernel ${kver}. Rebuild it with: sudo kernel-install add $kver /usr/lib/modules/$kver/vmlinuz"
        echo ">> Switching to automatic: always boot the newest kernel (${kver})"
        old_pin="$(tr -d '[:space:]' 2>/dev/null < "$DEFAULT_MARKER" || true)"
        write_pin ""
        if ! apply_boot_default "$kver" "$uki"; then
            if [ "$(grub_kver)" != "$kver" ] && have_mok && ! nvidia_ok "$kver"; then
                echo ">> NOTE: the NVIDIA driver is not built for ${kver}, so maze-sb-sign keeps"
                echo ">> booting $(grub_kver) for now and moves to ${kver} once its module exists."
            else
                write_pin "$old_pin"
                die "the boot image was not switched to ${kver}. Your previous default is unchanged."
            fi
        fi
        echo
        echo ">> Done. The newest installed kernel now boots by default."
        ;;

    *)
        usage
        ;;
esac

# End-to-end check of what the next reboot will run (cmdline, initramfs hooks,
# signatures). On failure it also blocks a careless reboot via maze-boot-guard.
# (install/remove already ran it from zzz-maze-boot-verify.hook.)
if [ "$cmd" = "set-default" ] || [ "$cmd" = "clear-default" ]; then
    command -v maze-boot-check >/dev/null 2>&1 || exit 0
    echo
    echo ">> Verifying the boot chain…"
    maze-boot-check --quiet || \
        die "the boot chain check FAILED — do not reboot yet. Run 'sudo maze-boot-check --repair'."
    echo ">> Boot chain OK."
fi
