#!/usr/bin/env python3
"""maze-guardd — Maze Linux privileged-action broker (root daemon).

WHY A DAEMON (not passwordless pkexec): a passwordless polkit rule on a root
script is a broad privilege-escalation surface — it leans on setuid pkexec (the
PwnKit class of bugs) and lets anything in the session run the helper. This
daemon instead exposes a NARROW, FIXED api over a wheel-only Unix socket:

  * The daemon runs as root; its code is root-owned and not user-writable, so it
    cannot be tampered with (no code injection into the privileged path).
  * It NEVER evals/execs caller-supplied strings. Each request is matched against
    a hard-coded whitelist of verbs; the device/action arguments are checked
    against fixed enums and only ever passed as a literal argv list (no shell).
  * Callers are authorised by SO_PEERCRED: the peer must be a real user with an
    ACTIVE session on a LOCAL seat per logind (mirrors polkit allow_active) —
    not root, not remote/SSH, not a background/lingering user.

Verbs:  PANIC | KILL <device> <on|off> | STATUS | PING
"""
import grp
import os
import pwd
import socket
import struct
import subprocess
import sys
import threading

SOCK = "/run/maze/guard.sock"
DEVICES = ("camera", "microphone", "bluetooth", "wifi", "usb")
CAM_BL = "/etc/modprobe.d/maze-killswitch-camera.conf"
CAM_MODS = ("uvcvideo", "gspca_main")
# Which network radios PANIC itself blocked, so RESTORE gives back exactly those
# and never re-enables a radio the user had switched off with a kill switch.
# Under /var (not /run): systemd-rfkill keeps the block across a reboot, so the
# record has to survive one too.
PANIC_RADIOS = "/var/lib/maze/panic-radios"
USBGUARD = "/usr/bin/usbguard"
USBGUARD_RULES = "/etc/usbguard/rules.conf"


def _run(*argv):
    """Run a FIXED argv with no shell. Never receives caller strings verbatim."""
    try:
        return subprocess.run(list(argv), capture_output=True, text=True, timeout=60)
    except Exception:
        return None


def _run_user(uid, *argv):
    """Run a FIXED argv AS the calling desktop user, inside their session.

    The mic kill needs PipeWire/WirePlumber tools (wpctl/pactl), which talk to the
    PER-USER sound server at $XDG_RUNTIME_DIR/pipewire-0. Root has no such session,
    so the old root-side `amixer` (ALSA) mute was silently overridden by PipeWire
    and never reached apps. argv stays a FIXED literal list (no shell); only the
    SO_PEERCRED-verified uid is variable."""
    try:
        pw = pwd.getpwuid(uid)
    except KeyError:
        return None
    env = {
        "XDG_RUNTIME_DIR": f"/run/user/{uid}",
        "HOME": pw.pw_dir,
        "PATH": "/usr/bin:/bin",
    }
    try:
        return subprocess.run(
            ["runuser", "-u", pw.pw_name, "--", *argv],
            capture_output=True, text=True, timeout=20, env=env,
        )
    except Exception:
        return None


# ---------------------------------------------------------------- panic ----
def _rfkill_state(kind):
    """'on' (some device unblocked), 'off' (all soft-blocked) or 'none'."""
    res = _run("rfkill", "list", kind)
    text = (res.stdout or "") if res else ""
    if not text.strip():
        return "none"
    return "on" if "Soft blocked: no" in text else "off"


def do_panic():
    # Cut the NETWORK radios (Wi-Fi + mobile) hard. Deliberately NOT bluetooth —
    # blocking BT would disconnect a BT mouse/keyboard and could strand the user
    # at the lock screen with no input. (nmcli on the client side also drops
    # ethernet + every NetworkManager connection.)
    was_on = [k for k in ("wifi", "wwan") if _rfkill_state(k) == "on"]
    for k in ("wifi", "wwan"):
        _run("rfkill", "block", k)
    # A second PANIC before a RESTORE finds everything blocked already; keep
    # the first record rather than overwriting it with an empty one.
    if was_on or not os.path.exists(PANIC_RADIOS):
        try:
            os.makedirs(os.path.dirname(PANIC_RADIOS), exist_ok=True)
            with open(PANIC_RADIOS, "w") as fh:
                fh.write(" ".join(was_on) + "\n")
        except OSError:
            pass
    _run("journalctl", "--rotate")
    _run("journalctl", "--vacuum-time=1s")
    for d in ("/var/log/journal", "/run/log/journal"):
        for root, dirs, files in os.walk(d, topdown=False):
            for f in files:
                try:
                    os.remove(os.path.join(root, f))
                except OSError:
                    pass
    for f in ("/var/log/auth.log", "/var/log/syslog", "/var/log/messages",
              "/var/log/kern.log", "/var/log/wtmp", "/var/log/btmp",
              "/var/log/lastlog", "/var/log/maze-sentinel.log",
              "/var/log/audit/audit.log", "/var/log/Xorg.0.log", "/var/log/sddm.log"):
        try:
            if os.path.exists(f):
                open(f, "w").close()
        except OSError:
            pass
    # journald still holds the files just unlinked above and would keep
    # writing into those deleted inodes — logging silently lost until the next
    # reboot. Rotating again makes it close them and open fresh ones.
    _run("journalctl", "--rotate")
    _run("systemctl", "kill", "--signal=SIGHUP", "auditd")
    # Flush page cache / dentries (cheap, non-disruptive). We deliberately do NOT
    # cycle swap (swapoff/swapon): on a low-RAM box swapoff can trigger the OOM
    # killer and kill the user's apps — exactly the kind of UX damage panic mode
    # must avoid. (True cold-RAM wiping is a separate, opt-in poweroff feature.)
    try:
        os.sync()
        with open("/proc/sys/vm/drop_caches", "w") as fh:
            fh.write("3")
    except OSError:
        pass
    return "OK panic"


def do_restore():
    # Undo the REVERSIBLE part of panic: un-block the network radios. rfkill state
    # is persisted by systemd-rfkill across reboots, so without this the radios
    # would stay dead even after a restart. (Logs/history stay wiped — by design.)
    # Only the radios PANIC itself switched off: Wi-Fi the user had killed in
    # Maze Hardware beforehand stays off. No record (panic from an older
    # version) falls back to the old behaviour of unblocking both.
    try:
        with open(PANIC_RADIOS) as fh:
            kinds = [k for k in fh.read().split() if k in ("wifi", "wwan")]
    except OSError:
        kinds = ["wifi", "wwan"]
    for k in kinds:
        _run("rfkill", "unblock", k)
    try:
        os.remove(PANIC_RADIOS)
    except OSError:
        pass
    still = [k for k in kinds if _rfkill_state(k) == "off"]
    if still:
        return "ERR restore-failed " + ",".join(still)
    return "OK restored"


# ------------------------------------------------------------ killswitch ----
def _camera(action):
    if action == "off":
        with open(CAM_BL, "w") as fh:
            fh.write("# Maze killswitch: camera disabled\nblacklist uvcvideo\nblacklist gspca_main\n")
        for m in CAM_MODS:
            _run("modprobe", "-r", m)
        # modprobe -r fails while an app has the camera open. This used to
        # report success anyway and the UI said "Off" over a live webcam.
        if any(_mod_loaded(m) for m in CAM_MODS):
            return "ERR camera-in-use"
    else:
        try:
            os.remove(CAM_BL)
        except OSError:
            pass
        for m in CAM_MODS:
            _run("modprobe", m)
    return None


def _mic(action, uid):
    # PipeWire owns the mixer on this desktop — mute at the SESSION layer or it
    # never reaches apps. Mute the default source AND every source so nothing can
    # still capture, then keep the ALSA mute as a fallback for a pure-ALSA box.
    val = "1" if action == "off" else "0"
    if uid is not None:
        _run_user(uid, "wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", val)
        res = _run_user(uid, "pactl", "list", "short", "sources")
        if res and res.returncode == 0:
            for line in (res.stdout or "").splitlines():
                parts = line.split()
                if parts:
                    _run_user(uid, "pactl", "set-source-mute", parts[0], val)
    _mic_alsa(action)


def _mic_alsa(action):
    mute = action == "off"
    cards = []
    try:
        with open("/proc/asound/cards") as fh:
            for line in fh:
                line = line.strip()
                if line and line[0].isdigit():
                    cards.append(line.split()[0])
    except OSError:
        pass
    for c in (cards or ["0"]):
        for ctrl in ("Capture", "Internal Mic", "Mic", "Front Mic", "Rear Mic", "Digital"):
            _run("amixer", "-c", c, "set", ctrl, "nocap" if mute else "cap")
            _run("amixer", "-c", c, "set", ctrl, "mute" if mute else "unmute")


def _radio(dev, action):
    _run("rfkill", "block" if action == "off" else "unblock", dev)


def _usb(action):
    if action == "off":
        if not os.path.exists(USBGUARD):
            return "ERR usb-unavailable"
        # The allow-list for everything plugged in RIGHT NOW. If it cannot be
        # produced, stop: enabling usbguard with ImplicitPolicyTarget=block and
        # an empty or stale rule file de-authorises the keyboard and mouse too.
        res = _run(USBGUARD, "generate-policy")
        if not res or res.returncode != 0 or "allow" not in (res.stdout or ""):
            return "ERR usb-policy-failed"
        try:
            # usbguard-daemon refuses a rules file readable by others; write
            # 0600 into a temp file and rename, so a crash never leaves a
            # half-written allow-list behind.
            tmp = USBGUARD_RULES + ".maze-new"
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as fh:
                fh.write(res.stdout)
            os.chmod(tmp, 0o600)
            os.replace(tmp, USBGUARD_RULES)
        except OSError:
            return "ERR usb-policy-failed"
        _set_usbguard_block()
        _run("systemctl", "enable", "--now", "usbguard")
    else:
        _run("systemctl", "disable", "--now", "usbguard")
        # Stopping usbguard does NOT undo the blocks it applied: every device it
        # rejected was left de-authorized in the kernel (sysfs authorized=0), so
        # without this newly-plugged sticks stay dead and never mount even though
        # the UI shows USB "on". Re-authorize every USB device + the per-port
        # default so hot-plug/mount works again.
        _usb_reauthorize()
    return None


def _usb_reauthorize():
    base = "/sys/bus/usb/devices"
    try:
        entries = os.listdir(base)
    except OSError:
        return
    # Restore the per-controller defaults first so devices inserted from now on
    # are allowed, then re-authorize every device currently present.
    for attr in ("authorized_default", "interface_authorized_default", "authorized"):
        for entry in entries:
            path = os.path.join(base, entry, attr)
            try:
                with open(path, "w") as fh:
                    fh.write("1")
            except OSError:
                pass


def _set_usbguard_block():
    conf = "/etc/usbguard/usbguard-daemon.conf"
    try:
        with open(conf) as fh:
            lines = fh.readlines()
        out, seen = [], False
        for ln in lines:
            if ln.strip().startswith("ImplicitPolicyTarget"):
                out.append("ImplicitPolicyTarget=block\n"); seen = True
            else:
                out.append(ln)
        if not seen:
            out.append("ImplicitPolicyTarget=block\n")
        with open(conf, "w") as fh:
            fh.writelines(out)
    except OSError:
        pass


def do_kill(device, action, uid):
    if device not in DEVICES or action not in ("on", "off"):
        return "ERR bad-args"
    err = None
    if device == "camera":
        err = _camera(action)
    elif device == "microphone":
        _mic(action, uid)
    elif device in ("bluetooth", "wifi"):
        _radio(device, action)
    elif device == "usb":
        err = _usb(action)
    if err:
        return err
    # Report what the device IS now, not what was asked for: every step above
    # can fail quietly (a busy module, rfkill with no permission, PipeWire not
    # up), and a privacy switch that says "off" over a working device is worse
    # than one that admits it failed.
    now = _device_state(device, uid)
    if now not in (action, "none"):
        return f"ERR {device}-not-applied"
    return f"OK {device} {action}"


def _has_video_device():
    """A USB Video Class interface is present (class 0e), camera driver or not."""
    base = "/sys/bus/usb/devices"
    try:
        entries = os.listdir(base)
    except OSError:
        return False
    for e in entries:
        if ":" not in e:
            continue
        try:
            with open(os.path.join(base, e, "bInterfaceClass")) as fh:
                if fh.read().strip().lower() == "0e":
                    return True
        except OSError:
            continue
    return False


def _device_state(dev, uid):
    """'on' | 'off' | 'none' for one device — what it actually is right now."""
    if dev == "camera":
        # The driver being loaded is what makes the camera usable, so that
        # decides "on" even when the blacklist exists (unload failed). The
        # old rule called a camera with no driver loaded "off" on a machine
        # that has no camera at all.
        if any(_mod_loaded(m) for m in CAM_MODS):
            return "on"
        if os.path.exists(CAM_BL) or _has_video_device():
            return "off"
        return "none"
    if dev == "microphone":
        # From PipeWire (the layer the kill acts on); ALSA only when there is
        # no user session (e.g. status queried very early).
        if uid is not None:
            res = _run_user(uid, "wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
            text = (res.stdout or "") if res else ""
            if "MUTED" in text:
                return "off"
            if text.strip():
                return "on"
        res = _run("amixer", "-c", "0", "get", "Capture")
        return "off" if (res and "[off]" in (res.stdout or "")) else "on"
    if dev in ("bluetooth", "wifi"):
        # "none": no such device (e.g. a VM). Any unblocked adapter is "on".
        return _rfkill_state(dev)
    if dev == "usb":
        if not os.path.exists(USBGUARD):
            return "none"
        res = _run("systemctl", "is-active", "usbguard")
        return "off" if (res and (res.stdout or "").strip() == "active") else "on"
    return "none"


def do_status(uid):
    return "OK " + " ".join(f"{d}={_device_state(d, uid)}" for d in DEVICES)


def _mod_loaded(name):
    try:
        with open("/proc/modules") as fh:
            return any(line.startswith(name + " ") for line in fh)
    except OSError:
        return False


# --------------------------------------------------------------- server ----
def _peer_uid(conn):
    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", creds)
    return uid


def _has_local_active_session(uid):
    """True if the user has a session that is on a local seat, not remote, and
    in the foreground — logind's view of polkit's `allow_active`.

    This used to be `os.path.isdir(f"/run/user/{uid}")`, which the comment
    described as "an active local session" but is not one: that directory
    exists for ANY login, including SSH sessions and lingering users. So any
    process running as a `maze`-group user — a remote login, a malicious build
    script, a compromised app — could send PANIC and have root truncate the
    journal, audit.log, auth.log and wtmp/btmp: a one-line way to erase the
    trail of the very intrusion it came from. Requiring a seat-attached, local,
    foreground session keeps the panic button and kill switches working for the
    person at the keyboard and closes them to everyone else.

    Seatless sessions (SSH, and systemd >= 256's per-user "manager" session)
    never qualify. Session ids come from logind and are validated before use."""
    res = _run("loginctl", "show-user", str(uid), "-p", "Sessions", "--value")
    if not res or res.returncode != 0:
        return False
    for sid in (res.stdout or "").split():
        if not sid.isalnum():
            continue
        r = _run("loginctl", "show-session", sid,
                 "-p", "Seat", "-p", "Remote", "-p", "Active", "-p", "Class")
        if not r or r.returncode != 0:
            continue
        props = dict(line.split("=", 1) for line in (r.stdout or "").splitlines() if "=" in line)
        if (props.get("Seat") and props.get("Remote") == "no"
                and props.get("Active") == "yes"
                and props.get("Class", "").startswith("user")):
            return True
    return False


def _authorized(uid):
    # A real (non-root, non-nobody) user whose active session is at this
    # machine's own seat. See _has_local_active_session for why the old
    # /run/user/<uid> test was not enough.
    return 1000 <= uid < 65534 and _has_local_active_session(uid)


# Serialises the actual privileged actions (PANIC/KILL/USB policy writes), not
# the socket I/O. Without this, two threads could race on the same file (e.g.
# both rewriting CAM_BL or usbguard's ImplicitPolicyTarget) — something the old
# single-threaded loop got for free by construction, so accept()-per-thread
# below must not quietly drop it.
_ACTION_LOCK = threading.Lock()


def dispatch(line, uid):
    parts = line.split()
    if not parts:
        return "ERR empty"
    verb = parts[0].upper()
    if verb == "PING":
        return "OK pong"
    if verb == "PANIC":
        return do_panic()
    if verb == "RESTORE":
        return do_restore()
    if verb == "STATUS":
        return do_status(uid)
    if verb == "KILL" and len(parts) == 3:
        return do_kill(parts[1], parts[2], uid)
    return "ERR bad-command"


def _handle(conn):
    try:
        # A silent client must never hang the daemon. This bound used to be
        # enforced by running everything on one thread, which had a sharper
        # edge than intended: for as long as ONE client sat here without
        # sending anything, accept() was never called again, so a second,
        # perfectly legitimate request — including PANIC — queued behind it
        # and waited out the same 5 seconds. A local process needs nothing
        # more than the ability to open this socket (any `maze`-group member)
        # to hold that window open indefinitely by reconnecting just before
        # each timeout, which starves the one feature on this machine most
        # worth never delaying. Each connection now gets its own thread, so a
        # stalled peer blocks only itself.
        conn.settimeout(5)
        uid = _peer_uid(conn)
        if not _authorized(uid):
            conn.sendall(b"ERR unauthorized\n")
            return
        data = conn.recv(256).decode("utf-8", "replace").strip()
        # Only ever the FIRST line, capped length — no streaming/eval.
        line = data.splitlines()[0] if data else ""
        # The privileged action itself stays serialised — see _ACTION_LOCK's
        # own comment — so concurrency here buys availability (the accept
        # loop is never stuck on a silent peer) without weakening the
        # single-writer guarantee the file-writing verbs relied on before.
        with _ACTION_LOCK:
            reply = dispatch(line, uid)
        conn.sendall((reply + "\n").encode())
    except Exception as exc:  # never let one client kill the daemon
        try:
            conn.sendall(b"ERR internal\n")
        except OSError:
            pass
        sys.stderr.write(f"maze-guardd: {exc}\n")
    finally:
        conn.close()


def main():
    os.makedirs("/run/maze", mode=0o755, exist_ok=True)
    try:
        os.unlink(SOCK)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    # Lock the socket down to the `maze` group — root:maze 0660.
    #
    # It used to be root:wheel, which was a quiet contradiction: this socket
    # lives in /run/maze, and Maze Guard's helper sets that directory to
    # root:maze 0750. A user in wheel but not maze could not traverse the
    # directory to reach the socket at all, so the effective requirement was
    # "wheel AND maze" while the code claimed "wheel". Maze puts the first user
    # in both, so nothing visibly broke — but a second account added only to the
    # documented `maze` group would have found the kill switches silently dead.
    #
    # `maze` is the right group: it is what sysusers.d creates, what gates the
    # helper socket next to this one, and what owns Maze Cloak's config. wheel
    # is the sudo group and means something else. Falls back to wheel only if
    # `maze` does not exist, so an older system keeps working.
    try:
        gid = grp.getgrnam("maze").gr_gid
    except KeyError:
        try:
            gid = grp.getgrnam("wheel").gr_gid
        except KeyError:
            gid = None
    if gid is not None:
        try:
            os.chown(SOCK, 0, gid)
        except OSError:
            pass
    os.chmod(SOCK, 0o660)
    srv.listen(8)
    sys.stderr.write("maze-guardd: listening on " + SOCK + "\n")
    while True:
        try:
            conn, _ = srv.accept()
        except OSError:
            continue
        # One thread per connection: accept() must stay free to pick up the
        # NEXT client immediately, including a PANIC request queued behind a
        # peer that never sends anything. See _handle's own comment.
        threading.Thread(target=_handle, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    main()
