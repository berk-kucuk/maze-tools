#!/usr/bin/env bash
# maze-sentinel-setup — arm the extra audit watches Maze Sentinel needs and snapshot
# its initial baselines. Runs once on first boot (oneshot service), after auditd.
#
# It plants NO files (unlike the old honeypot). The high-value account/sudo watches
# already ship in the Maze baseline (/etc/audit/rules.d/maze.rules, keys "identity"
# and "sudoers"); this only ADDS what the baseline lacks — SSH remote-access keys
# and the SSH server config — and records the trusted initial set of SUID/SGID-root
# binaries and root (UID 0) accounts so the daemon's periodic scan has a clean
# reference. Idempotent / re-runnable.
set -uo pipefail

RULES="/etc/audit/rules.d/maze-sentinel.rules"
STATE_DIR="/var/lib/maze/sentinel"
MARKER="${STATE_DIR}/setup.done"
SUID_SCAN_DIRS="/usr/bin /usr/local/bin /usr/sbin /bin /sbin"
log() { printf '[maze-sentinel-setup] %s\n' "$*"; }

mkdir -p "${STATE_DIR}" 2>/dev/null || true

# ---- audit watches for the events the baseline does not already cover ----
# WRITE/attribute watches only (-p wa): we care about a key/config being ADDED or
# CHANGED, never merely read (reading was the false-positive trap the honeypot
# fell into). auditd can only watch paths that exist, so per-user authorized_keys
# is watched where present.
log "Arming SSH audit watches"
{
    echo "# Maze Sentinel extra watches — generated by maze-sentinel-setup."
    echo "# (account + sudoers watches live in the baseline maze.rules.)"
    # SSH server configuration.
    [[ -e /etc/ssh/sshd_config ]]   && echo '-w /etc/ssh/sshd_config -p wa -k maze_sshd'
    [[ -d /etc/ssh/sshd_config.d ]] && echo '-w /etc/ssh/sshd_config.d/ -p wa -k maze_sshd'
    # Remote-access keys: root + every human home that already has the file.
    [[ -e /root/.ssh/authorized_keys ]] && echo '-w /root/.ssh/authorized_keys -p wa -k maze_ssh_authkeys'
    for home in /home/*; do
        [[ -d "${home}" ]] || continue
        [[ -e "${home}/.ssh/authorized_keys" ]] \
            && printf -- '-w %s/.ssh/authorized_keys -p wa -k maze_ssh_authkeys\n' "${home}"
    done
} > "${RULES}"
chmod 640 "${RULES}" 2>/dev/null || true

# Load the new rules into the running kernel audit.
if command -v augenrules >/dev/null 2>&1; then
    augenrules --load >/dev/null 2>&1 || true
fi
auditctl -R "${RULES}" >/dev/null 2>&1 || true

# ---- snapshot the trusted initial baselines for the daemon's periodic scan ----
log "Snapshotting SUID/root-account baseline"
find ${SUID_SCAN_DIRS} -xdev -type f -perm /6000 2>/dev/null | sort -u > "${STATE_DIR}/suid.list" || true
awk -F: '$3==0 {print $1}' /etc/passwd 2>/dev/null | sort -u > "${STATE_DIR}/root-accounts.list" || true

touch "${MARKER}"
log "Maze Sentinel armed."
exit 0
