#!/usr/bin/env bash
# maze-sentinel — Maze Linux host security anomaly monitor.
#
# Replaces the old honeypot/deception layer. Instead of planting fake "canary"
# files (which legitimate tools — file managers, indexers, editors, dev tools —
# kept reading, producing constant false alarms), Sentinel watches for REAL
# security-relevant changes and, when one happens, shows a clear, plain-language
# desktop notification explaining what changed and what the user should do.
#
# What it reports (all rare on a normal desktop, so low false-positive):
#   * user/account changes      — writes to /etc/passwd, /etc/shadow, /etc/group…
#   * sudo/privilege changes     — writes to /etc/sudoers, /etc/sudoers.d/
#   * new SSH remote-access keys — writes to ~/.ssh/authorized_keys
#   * SSH server config changes  — writes to /etc/ssh/sshd_config[.d]
#   * a new root-privileged program — a new SUID/SGID-root binary appears
#   * a new administrator account   — a new UID 0 account appears
#
# The file-change events come from the kernel audit log (auditd): the identity/
# sudoers watches ship in the Maze baseline (/etc/audit/rules.d/maze.rules); the
# SSH ones are added by maze-sentinel-setup. The SUID/account anomalies come from
# a light periodic scan. Changes made by the package manager you ran
# (pacman/paru/makepkg) are treated as expected and only logged, not alerted.
#
# What is NOT alerted, and why (2.2.1) — each of these was a real notification
# on a real machine, and a monitor that cries wolf gets ignored:
#   * an event whose file names are all outside the watched files. On btrfs,
#     audit matches a watch by inode number, and every subvolume shares the
#     superblock, so Firefox writing in /home tripped "SSH server settings
#     changed". The PATH records say which file it really was;
#   * a write that did not happen because the file was not there (exit=-2):
#     `rm -f` of a missing sudoers.d entry is not a sudo change. A write that
#     was REFUSED (permission) is still reported, as an attempt;
#   * account and sshd changes while pacman is installing something: package
#     scriptlets run usermod/useradd (entropy-shield adds its group on every
#     upgrade). sudoers and authorized_keys changes are still alerted then —
#     a package touching those is rare and worth a look.
#
set -uo pipefail

AUDIT_LOG="/var/log/audit/audit.log"
ALERT_LOG="/var/log/maze-sentinel.log"
TRIGGER_DIR="/run/maze"
STATE_DIR="/var/lib/maze/sentinel"
CONF="/etc/maze/sentinel.conf"

# Defaults (overridable in $CONF).
NOTIFY=1
SCAN_INTERVAL=600
DEBOUNCE=15
BENIGN_WRITERS="pacman paru makepkg yay pikaur systemd-sysuser systemd-tmpfile"
SUID_SCAN_DIRS="/usr/bin /usr/local/bin /usr/sbin /bin /sbin"
# shellcheck source=/dev/null
[[ -r "${CONF}" ]] && . "${CONF}"

PACMAN_LOCK="/var/lib/pacman/db.lck"

log() {
    printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "${ALERT_LOG}" 2>/dev/null || true
}

# Send a desktop notification to every active user session (same /run/user bus
# trick as the other Maze notifiers).
notify_all() {
    local title="$1" body="$2" urgency="${3:-normal}"
    [[ "${NOTIFY}" = "1" ]] || return 0
    # The body carries names an attacker picks (the writing program, a file
    # path, an account name) and Plasma renders notification bodies as rich
    # text — a crafted name could show a fake link in a root-sent security
    # alert. Escape the markup characters so it is always shown as text.
    # (Quoted replacements: bash >= 5.2 expands a bare & to the match.)
    body="${body//&/"&amp;"}"; body="${body//</"&lt;"}"; body="${body//>/"&gt;"}"
    local d uid user addr
    for d in /run/user/*; do
        [[ -S "${d}/bus" ]] || continue
        uid="${d##*/}"
        user="$(id -nu "${uid}" 2>/dev/null)" || continue
        addr="unix:path=/run/user/${uid}/bus"
        sudo -u "${user}" env DBUS_SESSION_BUS_ADDRESS="${addr}" \
            notify-send -a "Maze Sentinel" -u "${urgency}" -i dialog-warning-symbolic \
            "${title}" "${body}" >/dev/null 2>&1 || true
    done
}

record_trigger() {
    {
        echo "time=$(date '+%Y-%m-%d %H:%M:%S')"
        echo "kind=$1"
        echo "detail=$2"
    } > "${TRIGGER_DIR}/sentinel-triggered" 2>/dev/null || true
}

# Collapse a burst of identical events (one action = several write syscalls) into
# a single notification, per change-type, within $DEBOUNCE seconds.
debounced() {
    local key="$1" stamp="${TRIGGER_DIR}/.sentinel-last.$1" now age
    now="$(date +%s)"
    if [[ -f "${stamp}" ]]; then
        age=$(( now - $(stat -c %Y "${stamp}" 2>/dev/null || echo 0) ))
        (( age < DEBOUNCE )) && return 0   # too soon -> debounce (skip)
    fi
    : > "${stamp}" 2>/dev/null || true
    return 1
}

# Is this writer one of the expected admin tools? Deciding on `comm` alone (as
# this used to) is spoofable by anything: comm is just the executable's file
# name, so `cp /bin/sh /tmp/pacman` — or prctl(PR_SET_NAME) — silenced every
# alert while it rewrote /etc/passwd or sudoers. So the kernel-reported exe
# must ALSO be an absolute path to a binary owned by an installed package, and
# its name (as comm shows it — audit truncates to 15 chars, which is why the
# config lists "systemd-sysuser") must be in BENIGN_WRITERS.
benign_writer() {
    local exe="$1" comm="$2" name
    [[ "${exe}" == /* && -x "${exe}" ]] || return 1
    name="${exe##*/}"; name="${name:0:15}"
    [[ "${name}" == "${comm}" ]] || return 1
    case " ${BENIGN_WRITERS} " in
        *" ${name} "*) ;;
        *) return 1 ;;
    esac
    pacman -Qqo "${exe}" >/dev/null 2>&1
}

# pacman is in the middle of a transaction. Both, not either: the lock alone
# can be stale after a crash, a process merely named pacman is anyone's. Only
# root can create the lock — and root could stop this daemon outright.
pacman_transaction() {
    [[ -e "${PACMAN_LOCK}" ]] && pgrep -x pacman >/dev/null 2>&1
}

# Is <path> one of the files watched under <key>? Prefixes, so the temporary
# and backup names the tools write and rename (passwd+, shadow-, .lock,
# sudoers.d/<file>, sshd_config.d/<file>) count as the file they replace.
path_is_watched() {
    local key="$1" path="$2"
    case "${key}" in
        identity)          case "${path}" in /etc/passwd*|/etc/group*|/etc/shadow*|/etc/gshadow*) return 0 ;; esac ;;
        sudoers)           case "${path}" in /etc/sudoers*) return 0 ;; esac ;;
        maze_sshd)         case "${path}" in /etc/ssh/sshd_config*) return 0 ;; esac ;;
        maze_ssh_authkeys) case "${path}" in */.ssh/authorized_keys*) return 0 ;; esac ;;
    esac
    return 1
}

# A quoted, hex-encoded (audit's form for names with spaces or odd bytes) or
# absent value of field <name> in an audit record.
audit_field() {
    local name="$1" rec="$2" v
    [[ "${rec}" == *" ${name}="* ]] || return 0
    v="${rec#* "${name}"=}"
    if [[ "${v}" == \"* ]]; then
        v="${v#\"}"; printf '%s' "${v%%\"*}"
    else
        v="${v%% *}"; v="${v%%$'\x1d'*}"
        [[ "${v}" =~ ^([0-9A-Fa-f]{2})+$ ]] || return 0
        printf '%b' "$(sed 's/../\\x&/g' <<<"${v}")"
    fi
}

# Which file the event was about, from its PATH records. Prints "watched",
# "elsewhere" (names present, none of them ours) or "unknown" (no names —
# an fd-based call): only "elsewhere" is a reason to stay quiet.
event_target() {
    local key="$1" cwd="$2" name seen=0
    shift 2
    for name in "$@"; do
        [[ -n "${name}" ]] || continue
        seen=1
        [[ "${name}" == /* ]] || name="${cwd%/}/${name}"
        if path_is_watched "${key}" "${name}"; then
            echo watched; return
        fi
    done
    (( seen )) && echo elsewhere || echo unknown
}

# React to a file-change audit event for one of our watched keys: the SYSCALL
# record, then the working directory and file names of its CWD/PATH records.
react_audit() {
    local raw="$1" key="$2" cwd="${3:-}"
    shift 3 2>/dev/null || shift $#
    local exe comm uid user prog success code target
    exe="$(sed -n 's/.* exe="\([^"]*\)".*/\1/p'   <<<"${raw}")"
    comm="$(sed -n 's/.* comm="\([^"]*\)".*/\1/p' <<<"${raw}")"
    uid="$(sed -n 's/.* uid=\([0-9]*\).*/\1/p'    <<<"${raw}" | head -1)"
    success="$(sed -n 's/.* success=\([a-z]*\).*/\1/p' <<<"${raw}")"
    code="$(sed -n 's/.* exit=\(-\{0,1\}[0-9]*\).*/\1/p' <<<"${raw}")"
    user="$(id -nu "${uid}" 2>/dev/null || echo "uid ${uid:-?}")"
    prog="${exe##*/}"; [[ -n "${prog}" ]] || prog="${comm:-a program}"

    # Not one of our files at all — an inode-number twin on another btrfs
    # subvolume. Logged with the names, so the claim can be checked.
    target="$(event_target "${key}" "${cwd}" "$@")"
    if [[ "${target}" == elsewhere ]]; then
        log "ignored [${key}] by ${prog} (${user}): not a watched file ($*)"
        return 0
    fi

    # Expected admin tooling (you ran it)? Log, do not alert.
    if benign_writer "${exe}" "${comm}"; then
        log "expected change [${key}] by ${exe} (${user}) — no alert"
        return 0
    fi

    # Nothing was there to change.
    if [[ "${success}" == no && "${code}" == -2 ]]; then
        log "no change [${key}] by ${prog} (${user}): file did not exist"
        return 0
    fi

    # A package scriptlet adding its group or user.
    if [[ "${key}" == identity || "${key}" == maze_sshd ]] && pacman_transaction; then
        log "package transaction [${key}] by ${prog} (${user}) — no alert"
        return 0
    fi

    # Refused by the kernel: nothing changed, but something tried.
    if [[ "${success}" == no ]]; then
        debounced "${key}-refused" && return 0
        log "REFUSED [${key}] by ${prog} (uid ${uid:-?}/${user}) exit=${code} :: ${raw}"
        record_trigger "${key}-refused" "${prog}/${user}"
        notify_all "Maze Sentinel: a protected file could not be changed" \
            "“${prog}”, running as ${user}, tried to change a protected system file (${key}) and was refused. Nothing was changed. If you do not recognise that program, investigate: sudo tail /var/log/maze-sentinel.log" \
            "normal"
        return 0
    fi

    # One notification per change-type per burst.
    debounced "${key}" && { log "debounced [${key}] by ${prog} (${user})"; return 0; }

    local title body urg
    case "${key}" in
        identity)
            title="Maze Sentinel: a user account changed"
            body="A system account file (users/passwords) was just modified by “${prog}” as ${user}. If you added/removed a user or changed a password, this is expected — ignore it. If you did NOT, an account may have been created without your knowledge; check: sudo tail /var/log/maze-sentinel.log"
            urg="normal" ;;
        sudoers)
            title="Maze Sentinel: admin (sudo) rights changed"
            body="The sudo permission files were just modified by “${prog}” as ${user}. These decide who can run commands as root. If you did not change sudo rights (or install software that did), investigate this now."
            urg="critical" ;;
        maze_ssh_authkeys)
            title="Maze Sentinel: a new SSH remote-access key was added"
            body="An SSH login key was added or changed by “${prog}” as ${user}. Such a key can let someone log into this computer over the network. If this was not you, remove the key and change your passwords."
            urg="critical" ;;
        maze_sshd)
            title="Maze Sentinel: SSH server settings changed"
            body="The SSH server configuration was just modified by “${prog}” as ${user}. If you did not change SSH settings, someone may be trying to enable remote access — investigate."
            urg="normal" ;;
        *)
            title="Maze Sentinel: a security-sensitive file changed"
            body="A monitored security file was modified by “${prog}” as ${user}. Details: sudo tail /var/log/maze-sentinel.log"
            urg="normal" ;;
    esac
    log "ALERT [${key}] by ${prog} (uid ${uid:-?}/${user}) :: ${raw}"
    record_trigger "${key}" "${prog}/${user}"
    notify_all "${title}" "${body}" "${urg}"
}

# ---- periodic baseline scan: new SUID/SGID-root binaries and root accounts ----
scan_suid()          { find ${SUID_SCAN_DIRS} -xdev -type f -perm /6000 2>/dev/null | sort -u; }
scan_root_accounts() { awk -F: '$3==0 {print $1}' /etc/passwd 2>/dev/null | sort -u; }
# Every SSH authorized_keys file, as "<path> (sha256 <prefix>)". The audit watches armed
# by maze-sentinel-setup only cover files that existed on first boot — and a
# fresh install has none — so creating ~/.ssh/authorized_keys, the classic way
# to plant remote access, was never reported. A new file or changed content
# shows up here as a new line.
scan_authkeys() {
    local f
    for f in /root/.ssh/authorized_keys /root/.ssh/authorized_keys2 \
             /home/*/.ssh/authorized_keys /home/*/.ssh/authorized_keys2; do
        [[ -f "${f}" ]] || continue
        sha256sum "${f}" 2>/dev/null | awk '{ printf "%s (sha256 %s)\n", $2, substr($1, 1, 16) }'
    done | sort -u
}

# Emit an alert for every line that is in $2 (current) but not in the baseline
# file $1, then adopt the current set as the new baseline (so each item alerts
# once). $3=kind, $4=title, $5=body-prefix, $6=urgency.
diff_and_alert() {
    local base="$1" current="$2" kind="$3" title="$4" prefix="$5" urg="$6"
    [[ -f "${base}" ]] || { printf '%s\n' "${current}" > "${base}"; return 0; }
    local new line
    new="$(comm -13 "${base}" <(printf '%s\n' "${current}") 2>/dev/null)"
    [[ -n "${new}" ]] || return 0
    while IFS= read -r line; do
        [[ -n "${line}" ]] || continue
        log "ALERT [${kind}] ${line}"
        record_trigger "${kind}" "${line}"
        notify_all "${title}" "${prefix}${line}" "${urg}"
    done <<< "${new}"
    printf '%s\n' "${current}" > "${base}"
}

baseline_loop() {
    local suid_base="${STATE_DIR}/suid.list"
    local acct_base="${STATE_DIR}/root-accounts.list"
    local keys_base="${STATE_DIR}/authorized-keys.list"
    # Seed baselines on first run (silently — this is the trusted initial state).
    [[ -f "${suid_base}" ]] || scan_suid          > "${suid_base}" 2>/dev/null || true
    [[ -f "${acct_base}" ]] || scan_root_accounts > "${acct_base}" 2>/dev/null || true
    [[ -f "${keys_base}" ]] || scan_authkeys      > "${keys_base}" 2>/dev/null || true
    while sleep "${SCAN_INTERVAL}"; do
        diff_and_alert "${suid_base}" "$(scan_suid)" "new-suid" \
            "Maze Sentinel: a new root-privileged program appeared" \
            "A new program that always runs with root privileges was found: " "normal"
        diff_and_alert "${acct_base}" "$(scan_root_accounts)" "new-root-account" \
            "Maze Sentinel: a new administrator account was created" \
            "A new account with full root privileges now exists: " "critical"
        diff_and_alert "${keys_base}" "$(scan_authkeys)" "ssh-authorized-keys" \
            "Maze Sentinel: an SSH remote-access key was added or changed" \
            "Such a key lets someone log into this computer over the network. If this was not you, remove it and change your passwords. File: " "critical"
    done
}

# ---- assembling one audit event from its records ---------------------------
# An event is a SYSCALL record (exe, uid, key), then CWD and PATH records with
# the same msg=audit(<time>:<serial>) id, ending with PROCTITLE. Other events'
# records can interleave; they are skipped. The event is judged when it ends —
# or when the next keyed SYSCALL arrives, too many foreign lines go by, or the
# log goes quiet — so a record lost along the way never loses the alert.
EV_ID="" EV_KEY="" EV_RAW="" EV_CWD="" EV_SKIP=0
EV_PATHS=()

event_id() {
    local id="${1#*msg=audit(}"
    printf '%s' "${id%%)*}"
}

finish_event() {
    [[ -n "${EV_ID}" ]] || return 0
    react_audit "${EV_RAW}" "${EV_KEY}" "${EV_CWD}" "${EV_PATHS[@]}"
    EV_ID="" EV_KEY="" EV_RAW="" EV_CWD="" EV_SKIP=0
    EV_PATHS=()
}

handle_line() {
    local line="$1" key=""
    if [[ "${line}" == type=SYSCALL* ]]; then
        case "${line}" in
            *'key="identity"'*)          key=identity ;;
            *'key="sudoers"'*)           key=sudoers ;;
            *'key="maze_ssh_authkeys"'*) key=maze_ssh_authkeys ;;
            *'key="maze_sshd"'*)         key=maze_sshd ;;
        esac
        if [[ -n "${key}" ]]; then
            finish_event
            EV_ID="$(event_id "${line}")" EV_KEY="${key}" EV_RAW="${line}"
            return 0
        fi
    fi
    [[ -n "${EV_ID}" ]] || return 0
    if [[ "$(event_id "${line}")" != "${EV_ID}" ]]; then
        (( ++EV_SKIP > 200 )) && finish_event
        return 0
    fi
    case "${line}" in
        type=CWD*)                  EV_CWD="$(audit_field cwd "${line}")" ;;
        type=PATH*)                 EV_PATHS+=("$(audit_field name "${line}")") ;;
        type=PROCTITLE*|type=EOE*)  finish_event ;;
    esac
}

main() {
    mkdir -p "${TRIGGER_DIR}" "${STATE_DIR}" 2>/dev/null || true
    # Root only: the log holds raw audit records — who changed what, with
    # which program. It was created 0644 by a bare touch before 2.2.1.
    ( umask 077; touch "${ALERT_LOG}" ) 2>/dev/null || true
    chmod 0600 "${ALERT_LOG}" 2>/dev/null || true

    # Wait for the audit log to appear (auditd may start just after us).
    for _ in $(seq 1 30); do [[ -e "${AUDIT_LOG}" ]] && break; sleep 2; done

    # Start the periodic SUID/account scanner in the background.
    baseline_loop &

    log "Maze Sentinel started (account/sudo/ssh change watch + SUID/root-account scan)"
    [[ -e "${AUDIT_LOG}" ]] || echo "maze-sentinel: no audit log; is auditd running?" >&2

    # React to auditd events for our security-relevant keys. A read timeout
    # judges a pending event when the log goes quiet after it.
    local line rc
    tail -Fn0 "${AUDIT_LOG}" 2>/dev/null | while true; do
        if IFS= read -r -t 2 line; then
            handle_line "${line}"
        else
            rc=$?
            (( rc > 128 )) || break   # EOF: tail went away
            finish_event
        fi
    done
}

# Sourced (maze-selftest) -> functions only; executed -> run.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main
fi
