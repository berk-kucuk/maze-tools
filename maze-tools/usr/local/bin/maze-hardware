#!/usr/bin/env python3
"""maze-hardware — Maze Linux hardware privacy controller.

One window with kernel/hardware-level kill switches for the camera, microphone,
Bluetooth, Wi-Fi and USB. Reads/flips state with the unprivileged maze-killswitch,
which forwards to the maze-switchd broker over its maze-group socket — no pkexec /
setuid in the path.

Every call runs asynchronously (QProcess): a USB policy change or a slow
PipeWire answer used to freeze the whole window for up to a minute. And the
state shown is only ever what the broker reported — when it cannot be reached,
the switches say "unknown" instead of the old default of showing every device
as "On", which for a privacy tool is the one wrong answer that matters.

The window is the same true-black OLED panel as the Control Center and
Welcome (maze_ui's OLED kit): black surface, faint white cards, the logo
watermark, and a faint red glow in the corner while anything is blocked. The
widgets are built once and updated in place, so a poll never makes the window
flicker and the switches can animate to the state the broker reports.
"""
from __future__ import annotations

import os
import sys

os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

sys.path.insert(0, "/usr/local/lib/maze")
import maze_ui as ui  # noqa: E402
from maze_i18n import set_language, tr  # noqa: E402

from PySide6.QtCore import (  # noqa: E402
    QEasingCurve, QPoint, QPointF, QProcess, QRectF, Qt, QTimer, QVariantAnimation,
)
from PySide6.QtGui import (  # noqa: E402
    QColor, QFont, QFontMetricsF, QIcon, QPainter, QPainterPath, QPen,
)
from PySide6.QtWidgets import (  # noqa: E402
    QAbstractButton,
    QApplication,
    QFrame,
    QHBoxLayout,
    QScrollArea,
    QVBoxLayout,
    QWidget,
)

KILL = "/usr/local/bin/maze-killswitch"
APP_ICON = "/usr/share/pixmaps/maze-hardware.svg"
# White line-art device icons drawn for this app (same 24px set as the kernel
# switcher's); a blocked device gets a red slash cut through it.
ICON_DIR = "/usr/share/pixmaps/maze-hardware"
WIN_W, WIN_H = 760, 840
POLL_MS = 5000   # the phone (Maze Connect) can flip a switch too — stay current

DEVICES = (
    ("camera", "Webcam", "camera.svg",
     "Unloads the camera driver and keeps it from loading again."),
    ("microphone", "Microphone", "microphone.svg",
     "Mutes every audio capture input."),
    ("bluetooth", "Bluetooth", "bluetooth.svg",
     "rfkill block (persists across reboot)."),
    ("wifi", "Wi-Fi", "wifi.svg",
     "rfkill block (persists across reboot)."),
    ("usb", "USB ports", "usb.svg",
     "USBGuard blocks NEW devices (current ones keep working)."),
)

# maze-switchd error codes -> what the user should read.
ERRORS = {
    "camera-in-use": "The camera is in use by an app. Close it and try again.",
    "usb-unavailable": "USBGuard is not installed, so USB cannot be locked.",
    "usb-policy-failed": "Could not build the allow-list for the connected USB "
                         "devices — nothing was changed.",
    "unauthorized": "Refused: switches only work for the user at this "
                    "machine (a member of the 'maze' group, local session).",
    "bad-args": "The broker rejected the request.",
}

RED = QColor(ui.BAD_RED)
GREEN = QColor(ui.OK_GREEN)


def _explain(reply: str) -> str:
    code = reply[3:].strip().split(" ")[0] if reply.startswith("ERR") else ""
    if code in ERRORS:
        return tr(ERRORS[code])
    if code.endswith("-not-applied"):
        return tr("The change did not take effect — the device is unchanged.")
    if not reply:
        return tr("maze-switchd is not running. Start it with: "
                  "sudo systemctl enable --now maze-switchd")
    return tr("Unexpected answer from maze-switchd: {r}").format(r=reply)


def _state_of(state: str) -> tuple[str, QColor]:
    return {
        "on": (tr("Allowed"), GREEN),
        "off": (tr("Blocked"), RED),
        "none": (tr("Not present"), QColor(ui.FAINT)),
    }.get(state, (tr("Unknown"), QColor(ui.UNK_GRAY)))


# -- device pieces -------------------------------------------------------------
class Switch(QAbstractButton):
    """An iOS-style switch. It only DRAWS the reported state: clicking asks
    the broker, the knob glides over once the broker confirms the change, and
    while the request is in flight the knob spins."""

    W, H = 52, 30

    def __init__(self) -> None:
        super().__init__()
        self.setFixedSize(self.W, self.H)
        self.setCursor(Qt.PointingHandCursor)
        self._allowed: bool | None = None
        self._pos = 0.0            # 0 = blocked (left), 1 = allowed (right)
        self._busy = False
        self._angle = 0
        self._anim = QVariantAnimation(self)
        self._anim.setDuration(260)
        self._anim.setEasingCurve(QEasingCurve.OutCubic)
        self._anim.valueChanged.connect(self._set_pos)
        self._spin = QTimer(self)
        self._spin.setInterval(16)
        self._spin.timeout.connect(self._tick)

    def _set_pos(self, v) -> None:
        self._pos = float(v)
        self.update()

    def _tick(self) -> None:
        self._angle = (self._angle + 9) % 360
        self.update()

    def set_state(self, allowed: bool | None, enabled: bool, busy: bool) -> None:
        if allowed is not None and allowed != self._allowed:
            target = 1.0 if allowed else 0.0
            if self._allowed is None or not self.isVisible():
                self._pos = target
            else:
                self._anim.stop()
                self._anim.setStartValue(self._pos)
                self._anim.setEndValue(target)
                self._anim.start()
        self._allowed = allowed
        self._busy = busy
        if busy:
            self._spin.start()
        else:
            self._spin.stop()
        self.setEnabled(enabled)
        self.setCursor(Qt.PointingHandCursor if enabled else Qt.ArrowCursor)
        self.update()

    def paintEvent(self, _event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        known = self._allowed is not None
        if not self.isEnabled() and not self._busy:
            p.setOpacity(0.38)
        r = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        track = QPainterPath()
        track.addRoundedRect(r, r.height() / 2, r.height() / 2)
        hover = self.underMouse() and self.isEnabled()
        t = self._pos if known else 0.5
        # Track fades from faint red (blocked) to solid white (allowed).
        red = QColor(RED.red(), RED.green(), RED.blue(), 70 if hover else 52)
        white = QColor(255, 255, 255, 255 if hover else 238)
        if not known:
            fill = QColor(255, 255, 255, 26)
        else:
            fill = ui.mix(red, white, t)
        p.fillPath(track, fill)
        if known and t < 0.99:
            p.setPen(QPen(QColor(RED.red(), RED.green(), RED.blue(),
                                 int(170 * (1 - t))), 1))
        else:
            p.setPen(QPen(QColor(255, 255, 255, 40 if not known else 0), 1))
        p.drawPath(track)
        d = r.height() - 6
        x = r.left() + 3 + (r.width() - d - 6) * t
        knob = QRectF(x, r.top() + 3, d, d)
        p.setPen(Qt.NoPen)
        # Soft shadow under the knob.
        p.setBrush(QColor(0, 0, 0, 60))
        p.drawEllipse(knob.adjusted(0, 1.2, 0, 1.2))
        kc = QColor(12, 12, 15) if (known and t > 0.5) else QColor(ui.TEXT)
        p.setBrush(kc)
        p.drawEllipse(knob)
        if self._busy:
            spin_c = QColor(ui.TEXT) if kc.lightness() < 128 else QColor(12, 12, 15)
            p.setPen(QPen(spin_c, 1.8, Qt.SolidLine, Qt.RoundCap))
            p.setBrush(Qt.NoBrush)
            p.drawArc(knob.adjusted(4.5, 4.5, -4.5, -4.5), -self._angle * 16, 250 * 16)
        p.end()

    def enterEvent(self, event) -> None:  # noqa: N802
        self.update()
        super().enterEvent(event)

    def leaveEvent(self, event) -> None:  # noqa: N802
        self.update()
        super().leaveEvent(event)


class DeviceRow(ui.GlassCard):
    """One device: tile, name, live state chip, description, and its switch."""

    def __init__(self, dev: str, title: str, icon: str, desc: str, on_toggle) -> None:
        super().__init__(radius=14)
        self._dev = dev
        self._state = "unknown"
        self.setFixedHeight(84)
        row = QHBoxLayout(self)
        row.setContentsMargins(16, 12, 18, 12)
        row.setSpacing(16)
        self.tile = ui.IconTile(os.path.join(ICON_DIR, icon), 52)
        row.addWidget(self.tile, 0, Qt.AlignVCenter)

        col = QVBoxLayout()
        col.setSpacing(4)
        head = QHBoxLayout()
        head.setSpacing(10)
        head.addWidget(ui.label(tr(title), 12.5, ui.TEXT, QFont.DemiBold))
        self.chip = ui.Chip()
        head.addWidget(self.chip, 0, Qt.AlignVCenter)
        head.addStretch(1)
        col.addStretch(1)
        col.addLayout(head)
        d = ui.label(tr(desc), 9.5, ui.DIM)
        d.setWordWrap(True)
        col.addWidget(d)
        col.addStretch(1)
        row.addLayout(col, 1)

        self.switch = Switch()
        self.switch.clicked.connect(
            lambda: on_toggle(dev, "off" if self._state == "on" else "on"))
        row.addWidget(self.switch, 0, Qt.AlignVCenter)

    def set_state(self, state: str, applying: bool, locked: bool) -> None:
        self._state = state
        self.tile.set_state(tint=RED if state == "off" else None,
                            dim=state not in ("on", "off"), slash=state == "off")
        self.set_tint(RED if state == "off" else None)
        if applying:
            self.chip.set(tr("Applying…"), QColor(ui.DIM))
        else:
            self.chip.set(*_state_of(state))
        allowed = {"on": True, "off": False}.get(state)
        self.switch.set_state(allowed, state in ("on", "off") and not locked, applying)
        self.switch.setToolTip(
            tr("Block") if state == "on" else tr("Allow") if state == "off" else "")


# -- summary -------------------------------------------------------------------
class PrivacyRing(QWidget):
    """A segmented ring, one arc per device: red = blocked, white = allowed,
    faint = absent/unknown. The centre shows how many are blocked."""

    def __init__(self, size: int = 112) -> None:
        super().__init__()
        self.setFixedSize(size, size)
        self._states: list[str] = ["unknown"] * len(DEVICES)

    def set_states(self, states: list[str]) -> None:
        if states != self._states:
            self._states = states
            self.update()

    def paintEvent(self, _event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(7, 7, -7, -7)
        n = len(self._states)
        gap = 14.0
        span = 360.0 / n - gap
        for i, st in enumerate(self._states):
            start = 90 - gap / 2 - i * (360.0 / n)
            if st == "off":
                glow = QPen(QColor(RED.red(), RED.green(), RED.blue(), 60), 12,
                            Qt.SolidLine, Qt.RoundCap)
                p.setPen(glow)
                p.drawArc(r, int(start * 16), int(-span * 16))
                pen = QPen(RED, 6, Qt.SolidLine, Qt.RoundCap)
            elif st == "on":
                pen = QPen(QColor(255, 255, 255, 225), 6, Qt.SolidLine, Qt.RoundCap)
            else:
                pen = QPen(QColor(255, 255, 255, 34), 6, Qt.SolidLine, Qt.RoundCap)
            p.setPen(pen)
            p.drawArc(r, int(start * 16), int(-span * 16))
        present = [s for s in self._states if s in ("on", "off")]
        blocked = sum(1 for s in present if s == "off")
        c = QRectF(self.rect())
        big = ui.font(24, QFont.Bold)
        small = ui.font(11, QFont.DemiBold)
        num = str(blocked) if present else "–"
        tail = f"/{len(present)}" if present else ""
        wn = QFontMetricsF(big).horizontalAdvance(num)
        wt = QFontMetricsF(small).horizontalAdvance(tail)
        x0 = c.center().x() - (wn + wt) / 2
        base = c.center().y() + 6
        p.setPen(QColor(ui.TEXT))
        p.setFont(big)
        p.drawText(QPointF(x0, base), num)
        p.setPen(QColor(ui.FAINT))
        p.setFont(small)
        p.drawText(QPointF(x0 + wn + 1, base), tail)
        if present:
            p.setFont(ui.font(6.5, QFont.Bold, 1.0))
            p.drawText(c.adjusted(0, c.height() / 2 + 12, 0, 0).toRect(), Qt.AlignHCenter | Qt.AlignTop,
                       ui.caps(tr("Blocked")))
        p.end()


# -- window --------------------------------------------------------------------
class Hardware(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self._drag: QPoint | None = None
        self._state: dict[str, str] = {}
        self._reachable: bool | None = None   # None = not asked yet
        self._message = ("", ui.DIM)
        self._busy = False                    # a KILL is in flight
        self._applying = ""                   # which device it is for
        self._queue: list[tuple[str, str]] = []
        self._status_proc: QProcess | None = None
        self._kill_proc: QProcess | None = None
        self._rows: dict[str, DeviceRow] = {}

        self.setWindowTitle("Maze Hardware")
        self.setWindowIcon(QIcon(APP_ICON))
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowSystemMenuHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        # The device list scrolls, so on a short screen (1366x768) the window
        # shrinks to fit instead of pushing its footer off the bottom edge.
        self.setFixedSize(WIN_W, ui.fit_height(WIN_H))

        self._root = ui.GlassWindow(self, ui.make_watermark())
        self._root.setGeometry(0, 0, self.width(), self.height())
        self._outer = QVBoxLayout(self._root)
        self._outer.setContentsMargins(28, 22, 28, 22)
        self._outer.setSpacing(0)
        self._build()

        self._timer = QTimer(self)
        self._timer.timeout.connect(self._poll)
        self._timer.start(POLL_MS)
        self._poll()

    # -- broker I/O (async) ---------------------------------------------------
    def _poll(self) -> None:
        # Never overlap: a status query while one (or a KILL) is still running
        # would just queue behind the broker's action lock.
        if self._busy or self._status_proc is not None:
            return
        p = QProcess(self)
        p.setProcessChannelMode(QProcess.MergedChannels)
        p.finished.connect(lambda code, _s, p=p: self._status_done(p, code))
        p.errorOccurred.connect(
            lambda err, p=p: self._status_done(p, -1)
            if err == QProcess.FailedToStart else None)
        self._status_proc = p
        p.start(KILL, ["status"])

    def _status_done(self, p: QProcess, code: int) -> None:
        if self._status_proc is not p:
            return
        self._status_proc = None
        out = bytes(p.readAll()).decode("utf-8", "replace").strip()
        p.deleteLater()
        line = next((ln for ln in out.splitlines() if ln.startswith(("OK", "ERR"))), "")
        new: dict[str, str] = {}
        if code == 0 and line.startswith("OK"):
            for tok in line[2:].split():
                k, _, v = tok.partition("=")
                if v in ("on", "off", "none"):
                    new[k] = v
            reachable = True
        else:
            reachable = False
            self._message = (_explain(line), ui.BAD_RED)
        if reachable and self._reachable is False:
            self._message = ("", ui.DIM)
        changed = new != self._state or reachable != self._reachable
        self._state, self._reachable = new, reachable
        if changed:
            self._sync()

    def _toggle(self, dev: str, action: str) -> None:
        if self._busy:
            return
        self._queue = [(dev, action)]
        self._run_next()

    def _block_cam_mic(self) -> None:
        if self._busy:
            return
        self._queue = [(d, "off") for d in ("camera", "microphone")
                       if self._state.get(d) == "on"]
        self._run_next()

    def _run_next(self) -> None:
        if not self._queue:
            return
        dev, action = self._queue.pop(0)
        self._busy = True
        self._applying = dev
        self._message = ("", ui.DIM)
        self._sync()
        p = QProcess(self)
        p.setProcessChannelMode(QProcess.MergedChannels)
        p.finished.connect(lambda code, _s, p=p: self._kill_done(p, code))
        p.errorOccurred.connect(
            lambda err, p=p: self._kill_done(p, -1)
            if err == QProcess.FailedToStart else None)
        self._kill_proc = p
        p.start(KILL, [dev, action])

    def _kill_done(self, p: QProcess, code: int) -> None:
        if self._kill_proc is not p:
            return
        self._kill_proc = None
        out = bytes(p.readAll()).decode("utf-8", "replace").strip()
        p.deleteLater()
        line = next((ln for ln in out.splitlines() if ln.startswith(("OK", "ERR"))), "")
        ok = code == 0 and line.startswith("OK")
        if ok:
            self._message = (tr("Done."), ui.OK_GREEN)
        else:
            self._message = (_explain(line), ui.BAD_RED)
            self._queue.clear()   # stop a multi-step action at the first failure
        self._busy = False
        self._applying = ""
        if ok and self._queue:
            self._run_next()
            return
        self._sync()
        self._poll()   # show what the device actually is now

    # -- UI: built once (and on a language change), then updated in place ------
    def _build(self) -> None:
        ui_clear(self._outer)
        self._rows.clear()
        self._outer.addLayout(self._header())
        self._outer.addSpacing(20)
        self._outer.addWidget(self._hero())
        self._outer.addSpacing(22)
        self._count = ui.label("", 8, ui.FAINT, QFont.DemiBold, 0.6)
        self._outer.addLayout(ui.section_label(tr("Devices"), self._count))
        self._outer.addSpacing(10)
        self._outer.addWidget(self._device_list(), 1)
        self._outer.addSpacing(14)
        self._outer.addLayout(self._footer())
        self._sync()

    def _sync(self) -> None:
        """Push the current state into the widgets (no rebuild)."""
        states = [self._state.get(d, "unknown") if self._reachable else "unknown"
                  for d, *_ in DEVICES]
        for (dev, *_), st in zip(DEVICES, states, strict=True):
            self._rows[dev].set_state(st, dev == self._applying, self._busy)
        self._ring.set_states(states)

        present = [s for s in states if s in ("on", "off")]
        blocked = [s for s in present if s == "off"]
        if not self._reachable:
            head, dot = tr("Unknown — maze-switchd is not answering"), QColor(ui.UNK_GRAY)
        elif not blocked:
            head, dot = tr("Everything is allowed"), GREEN
        elif len(blocked) == len(present):
            head, dot = tr("Everything is blocked"), RED
        else:
            head = tr("{n} of {total} blocked").format(n=len(blocked), total=len(present))
            dot = RED
        self._headline.setText(head)
        self._status_chip.set(ui.caps(tr("Privacy status")), dot)
        self._count.setText(f"{len(present)} / {len(DEVICES)}" if self._reachable else "")
        self._root.set_glow(RED if blocked else None)

        cam_mic_on = any(self._state.get(d) == "on" for d in ("camera", "microphone"))
        self._quick.setEnabled(bool(self._reachable) and cam_mic_on and not self._busy)
        self._refresh.setEnabled(not self._busy)

        text, color = self._message
        if not text:
            text = tr("Blocking Wi-Fi or Bluetooth survives a reboot. "
                      "The camera stays off until you allow it again.")
            color = ui.FAINT
            glyph = "ⓘ"
        else:
            glyph = "✓" if color == ui.OK_GREEN else "!"
        self._msg_icon.setText(glyph)
        self._msg_icon.setStyleSheet(
            f"color: {color}; background: transparent;")
        self._msg.setText(text)
        self._msg.setStyleSheet(f"color: {color}; background: transparent;")

    def _header(self) -> QHBoxLayout:
        return ui.app_header(APP_ICON, "MAZE HARDWARE", tr("Hardware privacy"),
                             self._set_language, self.close, self.devicePixelRatioF())

    def _hero(self) -> QWidget:
        """Everything at a glance, plus the one action people reach for most."""
        card = ui.GlassCard(radius=14)
        lay = QHBoxLayout(card)
        lay.setContentsMargins(20, 18, 24, 18)
        lay.setSpacing(22)
        self._ring = PrivacyRing(112)
        lay.addWidget(self._ring, 0, Qt.AlignVCenter)
        col = QVBoxLayout()
        col.setSpacing(6)
        col.addStretch(1)
        chip_row = QHBoxLayout()
        self._status_chip = ui.Chip()
        chip_row.addWidget(self._status_chip)
        chip_row.addStretch(1)
        col.addLayout(chip_row)
        self._headline = ui.label("", 16, ui.TEXT, QFont.Bold)
        self._headline.setWordWrap(True)
        col.addWidget(self._headline)
        sub = ui.label(tr("Kernel-level kill switches — no physical switch needed."),
                     9.5, ui.DIM)
        sub.setWordWrap(True)
        col.addWidget(sub)
        col.addSpacing(8)
        actions = QHBoxLayout()
        # "&&": a single & is a Qt mnemonic marker and would vanish.
        shield = ui.svg_pixmap(APP_ICON, 16, self.devicePixelRatioF(), QColor(10, 10, 12))
        self._quick = ui.pill_button(tr("Block camera & mic").replace("&", "&&"),
                                   kind="primary", icon=shield)
        self._quick.clicked.connect(self._block_cam_mic)
        actions.addWidget(self._quick)
        actions.addStretch(1)
        col.addLayout(actions)
        col.addStretch(1)
        lay.addLayout(col, 1)
        return card

    def _device_list(self) -> QScrollArea:
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        scroll.setStyleSheet("""
            QScrollArea { background: transparent; border: none; }
            QScrollArea > QWidget > QWidget { background: transparent; }
            QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
            QScrollBar::handle:vertical { background: rgba(255,255,255,0.18);
                                          border-radius: 4px; min-height: 32px; }
            QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.32); }
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
            QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
        """)
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        col = QVBoxLayout(inner)
        col.setContentsMargins(0, 0, 0, 0)
        col.setSpacing(8)
        for dev, title, icon, desc in DEVICES:
            row = DeviceRow(dev, title, icon, desc, self._toggle)
            self._rows[dev] = row
            col.addWidget(row)
        col.addStretch(1)
        scroll.setWidget(inner)
        return scroll

    def _footer(self) -> QHBoxLayout:
        f = QHBoxLayout()
        f.setContentsMargins(6, 0, 0, 0)
        f.setSpacing(10)
        self._msg_icon = ui.label("", 11, ui.FAINT, QFont.Bold)
        self._msg_icon.setFixedWidth(16)
        f.addWidget(self._msg_icon, 0, Qt.AlignTop)
        self._msg = ui.label("", 9, ui.FAINT)
        self._msg.setWordWrap(True)
        f.addWidget(self._msg, 1)
        f.addSpacing(12)
        refresh_ic = ui.themed_pixmap(("view-refresh",), 16)
        self._refresh = ui.pill_button(tr("Refresh"), icon=refresh_ic)
        self._refresh.clicked.connect(self._poll)
        f.addWidget(self._refresh, 0, Qt.AlignVCenter)
        return f

    def _set_language(self, code: str) -> None:
        set_language(code)
        self._build()

    # -- window behaviour -----------------------------------------------------
    def show_centered(self) -> None:
        screen = QApplication.primaryScreen().availableGeometry()
        geo = self.frameGeometry()
        geo.moveCenter(screen.center())
        self.move(geo.topLeft())
        self.show()
        ui.enable_kde_blur(int(self.winId()), ui.blur_region(
            self.width(), self.height(), self.devicePixelRatioF()))

    def closeEvent(self, event) -> None:  # noqa: N802
        # Let an in-flight switch finish: killing maze-killswitch mid-request
        # leaves the user not knowing whether the device was blocked.
        if self._busy:
            event.ignore()
            return
        self._timer.stop()
        super().closeEvent(event)

    def mousePressEvent(self, event) -> None:  # noqa: N802
        if event.button() == Qt.LeftButton and event.position().y() < 80:
            self._drag = event.globalPosition().toPoint() - self.pos()

    def mouseMoveEvent(self, event) -> None:  # noqa: N802
        if self._drag is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self._drag)

    def mouseReleaseEvent(self, event) -> None:  # noqa: N802
        self._drag = None

    def keyPressEvent(self, event) -> None:  # noqa: N802
        if event.key() == Qt.Key_Escape:
            self.close()
            return
        super().keyPressEvent(event)


def ui_clear(lay) -> None:
    """Empty a layout recursively (nested layouts included)."""
    while lay.count():
        it = lay.takeAt(0)
        w = it.widget()
        if w is not None:
            w.setParent(None)
            w.deleteLater()
        elif it.layout() is not None:
            ui_clear(it.layout())
            it.layout().deleteLater()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Maze Hardware")
    app.setDesktopFileName("maze-hardware")
    app.setWindowIcon(QIcon(APP_ICON))
    w = Hardware()
    w.show_centered()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
