# Only the pure helper is executed, lifted out of the module with ast: the
# module itself pulls in the app's config machinery.
import ast, os, tempfile
src = open(os.environ["SRC"]).read()
fn = next((n for n in ast.parse(src).body if isinstance(n, ast.FunctionDef) and n.name == "_public_share_dir"), None)
if fn is None:
    print("FAIL onion server has no Public-folder default")
    raise SystemExit
ns = {"os": os}
exec(compile(ast.Module([fn], []), "onion_server", "exec"), ns)
f = ns["_public_share_dir"]
with tempfile.TemporaryDirectory() as home:
    print(("OK" if f(home) == os.path.join(home, "Public") else "FAIL") + " default share folder is ~/Public, not the home directory")
    os.makedirs(os.path.join(home, ".config"))
    with open(os.path.join(home, ".config", "user-dirs.dirs"), "w") as fh:
        fh.write('XDG_PUBLICSHARE_DIR="$HOME/Genel"\n')
    print(("OK" if f(home) == os.path.join(home, "Genel") else "FAIL") + " a localised Public folder (e.g. ~/Genel) is honoured")
print(("OK" if "Refusing to publish" in src else "FAIL") + " publishing the home directory (or anything above it) is refused")
PY
    file_has "${ES}/daemon.py" 'if firewall_backend() == "iptables":' \
        "panic only flushes iptables when Entropy Shield itself uses iptables (Docker/VPN rules survive)"
    if [[ -z "${PKGROOT}" ]]; then
        cfgf="${REAL_HOME}/.config/entropy-shield/config.json"
        if [[ -r "${cfgf}" ]]; then
            sd="$("${SYS_PY}" -c 'import json,sys; print((json.load(open(sys.argv[1])).get("onion_server") or {}).get("serve_dir","") or "")' "${cfgf}" 2>/dev/null)"
            if [[ -n "${sd}" ]]; then
                rs="$(realpath -m "${sd}")"; rh="$(realpath -m "${REAL_HOME}")"
                if [[ "${rh}" == "${rs}" || "${rh}" == "${rs%/}/"* ]]; then
                    warn "your onion server folder is ${sd} — it contains your whole home and will now be refused" "choose a sharing folder in Entropy Shield → Settings → Onion Server"
                else
                    pass "your onion server folder (${sd}) does not expose your home directory"
                fi
            fi
        fi
    fi
fi

# =========================================================== 12. HazeDrop =====
section "12. HazeDrop — link key required, truncated transfers rejected"
if need hazedrop 1.5.0-2; then
    file_has "${P}/opt/hazedrop/hazedrop/core/web_template.py" "body.key=" "browser page sends the key from the link's #fragment"
    py_check "${VENV_PY:-${SYS_PY}}" PYTHONPATH="${P}/opt/hazedrop" <<'PY'
# A real server on 127.0.0.1 with a random file, then the three requests that
# matter. Nothing leaves the machine; Tor is not involved.
import asyncio, base64, os, socket, tempfile
import aiohttp
from hazedrop.core import crypto
from hazedrop.core.session import DropSession
from hazedrop.core.server import TorDropServer

def free_port():
    s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p

async def web_test(path, data):
    key = crypto.generate_key()
    sess = DropSession(filepath=path, filename="selftest.bin", filesize=len(data), password=None,
                       once=False, expire_seconds=None, salt=None, key=key, max_downloads=10)
    port = free_port()
    srv = TorDropServer(sess, port)
    await srv.start()
    try:
        url = f"http://127.0.0.1:{port}/web-download"
        async with aiohttp.ClientSession() as c:
            async with c.post(url, json={}) as r:
                print(("OK" if r.status == 403 else "FAIL") + f" download with only the .onion address is refused (HTTP {r.status})")
            wrong = base64.urlsafe_b64encode(os.urandom(32)).rstrip(b"=").decode()
            async with c.post(url, json={"key": wrong}) as r:
                print(("OK" if r.status == 403 else "FAIL") + f" download with a wrong key is refused (HTTP {r.status})")
            frag = crypto.build_share_url("selftest.onion", key, False, "0" * 16).split("#", 1)[1]
            async with c.post(url, json={"key": frag.split(":")[0]}) as r:
                body = await r.read()
                ok = r.status == 200 and body == data
                print(("OK" if ok else "FAIL") + f" download with the key from the link works and is byte-identical (HTTP {r.status})")
    finally:
        await srv.stop()

with tempfile.TemporaryDirectory() as d:
    path = os.path.join(d, "selftest.bin")
    data = os.urandom(200_000)                # 4 chunks of 64 KiB
    with open(path, "wb") as f:
        f.write(data)
    asyncio.run(web_test(path, data))

    key = crypto.generate_key()
    parts = list(crypto.encrypt_file_chunked(path, key))
    _, pt = crypto.decrypt_file_chunked(b"".join(parts), key)
    print(("OK" if pt == data else "FAIL") + " a complete transfer decrypts to the original file")
    cut = b"".join(parts[:3])                 # header + 2 of 4 chunks, cut on a chunk boundary
    try:
        crypto.decrypt_file_chunked(cut, key)
        print("FAIL a transfer cut short is accepted as a complete file")
    except ValueError as e:
        print("OK a transfer cut short is rejected (" + str(e) + ")")
PY
fi

