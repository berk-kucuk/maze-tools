import random
from mazecloak.core import mac
rng = getattr(mac, "_rng", None)
print(("OK" if isinstance(rng, random.SystemRandom) else "FAIL") +
      " addresses come from the OS CSPRNG (SystemRandom), not a predictable generator")
cur = "3c:52:82:11:22:33"
for strat in (mac.FULL_RANDOM, mac.KEEP_VENDOR, mac.RANDOM_VENDOR):
    seen = {mac.random_mac(strat, cur) for _ in range(300)}
    bad = [a for a in seen if not mac.is_valid(a) or int(a[:2], 16) & 0x03 != 0x02]
    ok = not bad and len(seen) > 290
    print(("OK " if ok else "FAIL ") + f"{strat}: 300 addresses, {len(seen)} distinct, all valid locally-administered unicast"
          + ("" if not bad else f" — bad: {bad[:3]}"))
PY
    file_has "${P}/opt/maze-cloak/mazecloak/core/interfaces.py" '"link", "set", "dev"' \
        "interface names are passed with 'dev' (a name like 'up' cannot be misread)"
