rm = "--remove-rich-rule"
cases = [
    ([rm, 'rule family="ipv4" source mac="aa:bb:cc:dd:ee:ff" drop'], True,  "removing a block by MAC address asks for authorisation"),
    ([rm, 'rule family="ipv4" source address="10.0.0.9" drop'],       True,  "removing a block by IP address asks for authorisation"),
    (["--list-all"],                                                   False, "harmless commands do not ask"),
]
