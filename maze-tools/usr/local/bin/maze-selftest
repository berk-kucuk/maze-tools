# ============================================================ 16. Maze AI =====
section "16. Maze AI — commands that run without asking"
if need maze-ai 1.17.1-2; then
    sp="$(ls -d "${P}"/usr/lib/python3*/site-packages 2>/dev/null | head -1)"
    py_check "${SYS_PY}" PYTHONPATH="${sp}" <<'PY'
from maze_ai.agent.safety import is_readonly_command
refuse = [
    "rg --pre=/tmp/evil foo .", "rg --pre /tmp/evil foo",
    "sort --compress-program=/tmp/evil -S 1 file.txt", "ag --pager=/tmp/evil foo",
    "git diff --ext-diff", "git log -p --textconv", "git diff --output=/home/u/.bashrc",
    "git branch -D main", "git branch -m old new", "git tag -d v1.0",
    "git remote add evil https://evil.tld/repo.git", "git remote set-url origin https://evil.tld/repo.git",
]
allow = ["rg foo .", "ag foo", "git branch", "git branch -a", "git tag -l", "git remote -v", "git show HEAD", "ls -la"]
bad = [c for c in refuse if is_readonly_command(c)]
print(("OK" if not bad else "FAIL") + f" {len(refuse) - len(bad)}/{len(refuse)} dangerous commands need your approval")
for c in bad:
    print(f"FAIL runs without asking: {c}")
bad = [c for c in allow if not is_readonly_command(c)]
print(("OK" if not bad else "FAIL") + f" {len(allow) - len(bad)}/{len(allow)} ordinary read-only commands still run without a prompt")
for c in bad:
    print(f"WARN now asks for: {c}")
PY
fi

# ==================================================== 17. installed system =====
section "17. Installation — disk encryption key, leftovers"
if [[ -n "${PKGROOT}" ]]; then
    skip "installation checks only apply to the running system"
else
    rootsrc="$(findmnt -no SOURCE / 2>/dev/null)"; rootsrc="${rootsrc%%\[*}"
    if [[ -n "${rootsrc}" ]] && lsblk -rsno TYPE "${rootsrc}" 2>/dev/null | grep -qx crypt; then
        luks=1; info "root file system is encrypted (LUKS)"
    else
        luks=0; info "root file system is not encrypted — keyfile checks do not apply"
    fi
    if [[ "${luks}" -eq 1 ]]; then
        hits="$(grep -lE '^[[:space:]]*FILES=\([^)]*crypto_keyfile\.bin' /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf 2>/dev/null)"
        if [[ -n "${hits}" ]]; then fail "LUKS keyfile is listed in FILES=() of: ${hits//$'\n'/ }" "it ends up on the unencrypted ESP; remove it there, then: sudo maze-initramfs-rebuild"
        else pass "the LUKS keyfile is not added to the boot image (mkinitcpio FILES)"; fi
        if [[ "${IS_ROOT}" -ne 1 ]]; then
            skip "looking inside the boot images needs root"
        elif ! has objcopy || ! has lsinitcpio; then
            skip "objcopy/lsinitcpio missing — cannot look inside the boot images"
        elif esp="$(find_esp)"; then
            shopt -s nullglob
            imgs=("${esp}"/EFI/Linux/*.efi "${esp}"/EFI/BOOT/grubx64.efi*)
            shopt -u nullglob
            checked=0
            for img in "${imgs[@]}"; do
                [[ -f "${img}" ]] || continue
                case "${img}" in *.maze-kver|*.kver) continue ;; esac
                ird="${TMP}/initrd"
                rm -f "${ird}"
                objcopy -O binary --only-section=.initrd "${img}" "${ird}" 2>/dev/null && [[ -s "${ird}" ]] || continue
                list="$(lsinitcpio -l "${ird}" 2>/dev/null)" || continue
                checked=$((checked + 1))
                if grep -qxE '(\./)?crypto_keyfile\.bin' <<<"${list}"; then
                    fail "$(basename "${img}") on the ESP CONTAINS the LUKS keyfile" "the disk can be unlocked without your passphrase; check /etc/mkinitcpio.conf FILES=(), then: sudo maze-initramfs-rebuild"
                fi
            done
            rm -f "${TMP}/initrd"
            if [[ "${checked}" -gt 0 ]]; then pass "checked ${checked} boot image(s) on the ESP: no LUKS keyfile inside"
            else info "no boot image with an initrd found on the ESP"; fi
        fi
    fi
    if pacman -Qq cloud-init >/dev/null 2>&1; then
        warn "cloud-init is installed (from an older ISO); Maze does not use it" "remove: sudo pacman -Rns cloud-init"
    else
        pass "cloud-init is not installed"
    fi
    # What the installer itself recorded (maze-installer >= 2.0.0-33 writes it).
    _sum=/var/log/maze-install-summary.txt
    if [[ -r "${_sum}" ]]; then
        if grep -q '^CRITICAL' "${_sum}"; then
            fail "the installer recorded CRITICAL problems on this machine" "see ${_sum}"
            sed -n '/^CRITICAL/,/^$/p' "${_sum}" | sed -n '2,6p' | grep -v '^$' | while IFS= read -r l; do detail "${l}"; done
        else
            _nw="$(sed -n 's/^Warnings (\([0-9]*\)).*/\1/p' "${_sum}")"
            if [[ -n "${_nw}" && "${_nw}" -gt 0 ]]; then
                info "the installer finished with ${_nw} warning(s) — see ${_sum}"
            else
                pass "the installer finished without warnings"
            fi
        fi
    else
        info "no installer summary (installed with an older Maze installer)"
    fi
    if [[ -f /var/log/maze-kernel-install.log ]]; then
        if grep -qE -- '-> exit [1-9]' /var/log/maze-kernel-install.log 2>/dev/null; then
            warn "the installer logged a failed kernel-install" "see /var/log/maze-kernel-install.log"
        else
            pass "installer's kernel-install log shows no failures"
        fi
    else
        info "no /var/log/maze-kernel-install.log (installed with an older installer — nothing to check)"
    fi
fi

# ============================================================== summary =====
printf '\n%s== Summary ==%s\n' "${C_BOLD}" "${C_0}"
printf '  %s%d OK%s   %s%d WARN%s   %s%d FAIL%s   %s%d SKIP%s\n' \
    "${C_G}" "${N_PASS}" "${C_0}" "${C_Y}" "${N_WARN}" "${C_0}" "${C_R}" "${N_FAIL}" "${C_0}" "${C_M}" "${N_SKIP}" "${C_0}"
if [[ -n "${FAILS}" ]]; then printf '\n%sFailed:%s\n%s' "${C_R}" "${C_0}" "${FAILS}"; fi
if [[ -n "${WARNS}" ]]; then printf '\n%sWarnings:%s\n%s' "${C_Y}" "${C_0}" "${WARNS}"; fi
if [[ "${N_SKIP}" -gt 0 ]]; then
    printf '\nSKIP means the package is not updated yet (or the check needs root); update and run again.\n'
fi
[[ "${N_FAIL}" -eq 0 ]]
