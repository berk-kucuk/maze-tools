#!/bin/sh
# maze-apply-wallpaper — put the Maze wallpaper on EVERY desktop (every screen),
# on every login.
#
# Since maze-wallpaper (2026-10) the Maze desktop uses its own wallpaper plugin,
# com.mazelinux.wallpaper: the Maze wallpaper with active blur, plus live
# wallpapers and media mode from the Maze Wallpaper app. Systems without that
# package fall back to Active Blur (a2n.blur), as before.
#
# WHY: the skel sets the wallpaper plugin for a single desktop, but Plasma
# falls back to a plain org.kde.image desktop when the skel's screen mapping
# doesn't match the actual hardware (a VM, different monitors than the build
# host, or — most importantly — a monitor plugged in AFTER first login). In those
# cases only the primary screen gets Active Blur and the others get the plain
# "Image" wallpaper. Re-applying through Plasma scripting on each login, AFTER the
# desktops exist, guarantees blur on ALL screens, including hot-plugged ones.
#
# ONCE PER DESKTOP: each desktop Maze has handled is marked in its own config
# ([MazeLinux] WallpaperApplied=1) and never touched again. This used to convert
# every non-blur desktop on EVERY login, so a user who picked their own
# wallpaper plugin (a photo via "Image", a slideshow…) had it silently put back
# to Maze at the next login. A monitor plugged in later gets a NEW desktop with
# no mark, so it is still converted — which is what this script exists for.
set -u

QDBUS=""
for c in qdbus6 qdbus qdbus-qt6; do command -v "$c" >/dev/null 2>&1 && { QDBUS="$c"; break; }; done
[ -n "${QDBUS}" ] || exit 0

# Wait for plasmashell's scripting interface to be ready.
i=0
while [ "$i" -lt 30 ]; do
    "${QDBUS}" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript 'print(1)' >/dev/null 2>&1 && break
    i=$((i + 1)); sleep 2
done

# Maze Wallpaper when it is installed (maze-branding depends on it), else the
# per-user Active Blur that /etc/skel has always shipped.
if [ -f /usr/share/plasma/wallpapers/com.mazelinux.wallpaper/metadata.json ]; then
    PLUGIN="com.mazelinux.wallpaper"
else
    PLUGIN="a2n.blur"
fi

SCRIPT='
var preferred = "'"${PLUGIN}"'";
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    var d = ds[i];
    d.currentConfigGroup = ["MazeLinux"];
    var handled = (d.readConfig("WallpaperApplied", "") == "1");
    if (d.wallpaperPlugin == "a2n.blur") {
        // Already blurred — leave it, except for one migration: older Maze wrote
        // the raw PNG inside the package as Image. Plasma then lists that file as
        // a second wallpaper named after its resolution ("3344x1882") next to
        // "Maze". Pointing at the package directory instead lets MediaProxy pick
        // the best-fit image and the chooser shows a single "Maze" entry.
        d.currentConfigGroup = ["Wallpaper", "a2n.blur", "General"];
        var img = d.readConfig("Image", "");
        if (String(img).indexOf("/usr/share/wallpapers/Maze/contents/images/") != -1) {
            d.writeConfig("Image", "file:///usr/share/wallpapers/Maze/");
            d.reloadConfig();
        }
    } else if (d.wallpaperPlugin == "com.mazelinux.wallpaper") {
        // Already Maze Wallpaper; what it shows is the Maze Wallpaper app'"'"'s call.
    } else if (!handled && preferred == "com.mazelinux.wallpaper") {
        d.wallpaperPlugin = "com.mazelinux.wallpaper";
        d.currentConfigGroup = ["Wallpaper", "com.mazelinux.wallpaper", "General"];
        d.writeConfig("Kind", "image");
        d.writeConfig("Source", "/usr/share/wallpapers/Maze/contents/images/3344x1882.png");
        d.writeConfig("ActiveBlur", true);
        d.writeConfig("BlurRadius", 32);
        d.writeConfig("ActiveDim", 10);
        d.reloadConfig();
    } else if (!handled) {
        d.wallpaperPlugin = "a2n.blur";
        d.currentConfigGroup = ["Wallpaper", "a2n.blur", "General"];
        d.writeConfig("ActiveBlur", true);
        d.writeConfig("Image", "file:///usr/share/wallpapers/Maze/");
        d.writeConfig("BlurRadius", 50);
        d.writeConfig("AnimationDuration", 250);
        d.writeConfig("SlidePaths", "/usr/share/wallpapers/");
        d.reloadConfig();
    }
    if (!handled) {
        d.currentConfigGroup = ["MazeLinux"];
        d.writeConfig("WallpaperApplied", "1");
    }
}'

"${QDBUS}" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "${SCRIPT}" >/dev/null 2>&1 || true
exit 0
