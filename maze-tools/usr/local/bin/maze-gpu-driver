#!/usr/bin/env bash
#
# maze-gpu-driver — install & configure the NVIDIA proprietary driver on an
# installed Maze Linux system.
#
# Maze ships OPEN-SOURCE drivers by default (mesa + nouveau), which work out of
# the box and are Secure-Boot clean. Proprietary NVIDIA is OPT-IN: run this only
# if you have an NVIDIA GPU and want the proprietary driver.
#
# It handles the two things that make NVIDIA painful on a hardened/Secure-Boot
# system:
#   * KMS (nvidia-drm.modeset=1 + fbdev on the cmdline, modprobe.d options) so
#     the desktop comes up cleanly on the NVIDIA GPU. The modules are NOT put in
#     the initramfs — see the note at the MODULES step below.
#   * The kernel module. Arch builds nvidia-open (for `linux`) and
#     nvidia-open-lts (for `linux-lts`) itself, released minutes after each
#     kernel by the kernel's own packager. When every installed kernel is one of
#     those two, that is what gets installed: nothing is compiled on this
#     machine, no kernel headers are needed, and "the module did not build for
#     the new kernel" cannot happen. Any other kernel (zen, hardened, custom)
#     has no prebuilt module, so then — and only then — nvidia-open-dkms builds
#     it locally, signed with THIS machine's MOK key.
#
#     Module signatures: the Arch kernel does not enter lockdown under Secure
#     Boot and Maze does not set module.sig_enforce, so unsigned modules load
#     (measured: lockdown [none], sig_enforce N). The prebuilt modules are
#     therefore not MOK-signed. What Secure Boot protects here is the boot chain
#     on the unencrypted ESP, which this does not touch. If Maze ever enforces
#     module signatures, the prebuilt path needs a signing step first.
#   * GPU generation. Since driver 590 Arch ships ONLY the open kernel modules,
#     which need a Turing (RTX 20xx / GTX 16xx) or newer GPU. On Pascal and
#     older the module does not bind — and nvidia-utils still blacklists
#     nouveau, so the result is a black screen. Those cards are refused here
#     and stay on nouveau.
#
#   A machine installed with the older DKMS-only version of this script is
#   moved onto the prebuilt modules by simply running it again (interactively:
#   `--nvidia` also installs CUDA without asking).
#
# Usage:
#   sudo maze-gpu-driver            # interactive
#   sudo maze-gpu-driver --nvidia   # install NVIDIA proprietary, no prompt
#   sudo maze-gpu-driver --open     # revert to open-source (remove nvidia)
set -euo pipefail

KEYDIR=/var/lib/maze-secureboot
MOK_KEY="${KEYDIR}/MOK.key"
MOK_CRT="${KEYDIR}/MOK.crt"

log()  { printf '\033[1;37m[maze-gpu]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[maze-gpu] WARNING:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[maze-gpu] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

[[ "${EUID}" -eq 0 ]] || die "run as root (sudo maze-gpu-driver)"

MODE="ask"
case "${1:-}" in
    --nvidia) MODE="nvidia" ;;
    --open)   MODE="open" ;;
    "" )      MODE="ask" ;;
    *) die "unknown option '$1' (use --nvidia, --open, or no argument)" ;;
esac

has_nvidia_gpu() { lspci -nn 2>/dev/null | grep -iE 'VGA|3D|Display' | grep -qi 'NVIDIA'; }

# Sort the NVIDIA display controllers into ones the open kernel modules drive
# (Turing and newer) and ones they do not (Volta, Pascal, Maxwell, …). NVIDIA
# assigned PCI device IDs by generation: Turing starts at 0x1e00 (TU102 0x1e0x,
# TU104 0x1e8x, TU106 0x1f0x, TU117 0x1f9x, TU116 0x218x), everything after it is
# higher, and every earlier generation is below it (GP102 0x1b0x, GP107 0x1c8x,
# GV100 0x1dbx). PCI_DEVICES is overridable for tests.
PCI_DEVICES="${MAZE_PCI_DEVICES:-/sys/bus/pci/devices}"
nv_supported=(); nv_legacy=()
classify_nvidia_gpus() {
    local pd dev
    for pd in "${PCI_DEVICES}"/*; do
        [[ "$(cat "${pd}/vendor" 2>/dev/null)" == "0x10de" ]] || continue
        [[ "$(cat "${pd}/class" 2>/dev/null)" == 0x03* ]] || continue   # display controllers only
        dev="$(cat "${pd}/device" 2>/dev/null)"
        [[ -n "${dev}" ]] || continue
        if (( dev >= 0x1e00 )); then nv_supported+=("${pd##*/} ${dev}")
        else nv_legacy+=("${pd##*/} ${dev}")
        fi
    done
}

# Which module package(s) this machine needs. Prebuilt when every installed
# kernel is `linux` or `linux-lts` (the two Arch builds nvidia-open for);
# otherwise nvidia-open-dkms for all of them — mixing the two is not an option,
# nvidia-open-dkms conflicts with nvidia-open.
NV_MODE=""; nv_pkgs=(); nv_hdrs=()
plan_module_packages() {
    local d pb prebuilt=1 bases=()
    for d in /usr/lib/modules/*/; do
        [[ -f "${d}pkgbase" && -f "${d}vmlinuz" ]] || continue
        pb="$(cat "${d}pkgbase" 2>/dev/null || true)"
        [[ -n "${pb}" ]] || continue
        bases+=("${pb}")
        case "${pb}" in linux|linux-lts) ;; *) prebuilt=0 ;; esac
    done
    ((${#bases[@]})) || die "no installed kernel found under /usr/lib/modules"
    mapfile -t bases < <(printf '%s\n' "${bases[@]}" | sort -u)
    if ((prebuilt)); then
        NV_MODE="prebuilt"
        for pb in "${bases[@]}"; do
            case "${pb}" in
                linux)     nv_pkgs+=(nvidia-open) ;;
                linux-lts) nv_pkgs+=(nvidia-open-lts) ;;
            esac
        done
    else
        NV_MODE="dkms"
        nv_pkgs=(nvidia-open-dkms dkms)
        for pb in "${bases[@]}"; do nv_hdrs+=("${pb}-headers"); done
    fi
}

# True when the GPU that owns the panel (firmware's boot_vga) is the NVIDIA card
# — i.e. a desktop / no-iGPU box. On hybrid laptops the panel is on i915/amdgpu
# and the installer already settled the initramfs around that; nothing here
# should touch HOOKS there.
panel_is_nvidia() {
    local pd drv=""
    for pd in /sys/bus/pci/devices/*; do
        [[ "$(cat "${pd}/boot_vga" 2>/dev/null)" == "1" ]] || continue
        drv="$(basename "$(readlink -f "${pd}/driver" 2>/dev/null)" 2>/dev/null)"
        [[ -n "${drv}" ]] && break
        # bound to nothing (blacklisted nouveau, driver not yet built): go by vendor
        [[ "$(cat "${pd}/vendor" 2>/dev/null)" == "0x10de" ]] && drv="nvidia"
        break
    done
    case "${drv}" in nvidia|nouveau) return 0 ;; *) return 1 ;; esac
}

# The `kms` mkinitcpio hook only knows IN-TREE DRM drivers. With the proprietary
# driver installed it therefore adds NOUVEAU (matched by the PCI alias) and the
# whole /usr/lib/firmware/nvidia tree — ~110 MB — and the nvidia-utils blacklist
# that `modconf` copies in alongside then forbids nouveau from ever loading.
# Measured on a Ryzen 5700X + RTX 5060 desktop: 150 MB UKI with `kms`, of which
# 112 MB was that never-read firmware; Plymouth and the LUKS box were drawn on
# simpledrm the whole time and nvidia-drm only came up from the real root. So
# with nvidia on the panel, `kms` costs ~10 s of firmware+loader time per boot
# and buys nothing. With nouveau on the panel it is what puts the splash on the
# real GPU, so it goes back in when reverting.
drop_kms_hook() {
    [[ -f /etc/mkinitcpio.conf ]] || return 0
    grep -qE '^[[:space:]]*HOOKS=\([^)]*\bkms\b' /etc/mkinitcpio.conf || return 0
    sed -i -E '/^[[:space:]]*HOOKS=/ s/[[:space:]]*\bkms\b//' /etc/mkinitcpio.conf \
        && log "removed 'kms' from mkinitcpio HOOKS (would only add blacklisted nouveau + ~110 MB firmware to the UKI)" \
        || warn "could not remove 'kms' from mkinitcpio HOOKS"
}
restore_kms_hook() {
    [[ -f /etc/mkinitcpio.conf ]] || return 0
    grep -qE '^[[:space:]]*HOOKS=\([^)]*\bkms\b' /etc/mkinitcpio.conf && return 0
    # Canonical Arch position: right after `microcode`, before `modconf`.
    if grep -qE '^[[:space:]]*HOOKS=\([^)]*\bmodconf\b' /etc/mkinitcpio.conf; then
        sed -i -E '/^[[:space:]]*HOOKS=/ s/\bmodconf\b/kms modconf/' /etc/mkinitcpio.conf \
            && log "restored 'kms' in mkinitcpio HOOKS (nouveau draws the splash on the real GPU)" \
            || warn "could not restore 'kms' in mkinitcpio HOOKS"
    else
        warn "mkinitcpio HOOKS has no 'modconf' anchor — 'kms' not restored, splash stays on simpledrm"
    fi
}

# Rebuild the actual booted UKI(s) for every installed kernel. Maze ships
# layout=uki (/etc/kernel/install.conf), so the real boot artifact lives at
# $ESP/EFI/Linux/<machine-id>-<kver>.efi and is built ONLY by `kernel-install
# add` (from the CURRENT /etc/mkinitcpio.conf MODULES + /etc/kernel/cmdline). A
# standalone `mkinitcpio -P` does NOT touch that file — it only regenerates the
# plain /boot/initramfs-*.img, which nothing boots — so callers must run this
# (not just mkinitcpio -P) whenever MODULES or cmdline changes, or the change
# never reaches the booted UKI.
rebuild_ukis() {
    local kdir kver out ok=0 fail=0
    for kdir in /usr/lib/modules/*/; do
        [[ -f "${kdir}vmlinuz" ]] || continue
        kver="$(basename "${kdir}")"
        # Output used to go to /dev/null, so the ONE message that explains a
        # broken boot ("module not found: 'nvidia'") was thrown away and the
        # run continued to its "REBOOT to load it" ending. Keep it.
        if out="$(kernel-install add "${kver}" "${kdir}vmlinuz" 2>&1)"; then
            ok=1
        else
            fail=1
            warn "kernel-install add FAILED for ${kver} — the UKI on the ESP is now STALE:"
            printf '%s\n' "${out}" | sed 's/^/    /' >&2
        fi
    done
    if ((!ok)); then
        warn "no kernel-install UKI was rebuilt"
        return 1
    fi
    if ((fail)); then return 1; fi
    return 0
}

# Verify the machine will actually boot what we just built — BEFORE telling the
# user to reboot. Every failure this catches is otherwise silent: kernel-install
# only warns, and the signer installs whatever UKI it finds. The end state is a
# machine booting a kernel whose /usr/lib/modules pacman has already deleted, so
# NO module loads at all — vfat included, which is why /boot cannot even be
# mounted afterwards to diagnose it.
verify_boot_chain() {
    local kver esp uki grub gk f rc=0 pin
    kver="$(for f in /usr/lib/modules/*/; do
                [[ -f "${f}vmlinuz" ]] || continue
                f="${f%/}"; printf '%s\n' "${f##*/}"
            done | sort -V | tail -1)"
    if [[ -z "${kver}" ]]; then
        warn "verify: no installed kernel found under /usr/lib/modules"
        return 1
    fi

    esp="$(bootctl --print-esp-path 2>/dev/null || true)"
    if [[ -z "${esp}" || ! -d "${esp}/EFI" ]]; then esp=""; fi
    if [[ -z "${esp}" && -d /boot/EFI ]]; then esp=/boot; fi
    if [[ -z "${esp}" && -d /efi/EFI  ]]; then esp=/efi;  fi
    if [[ -z "${esp}" ]]; then
        warn "verify: no ESP found — cannot confirm the boot image"
        return 1
    fi

    # The kernel grubx64.efi is SUPPOSED to carry: the one pinned with the
    # Kernel Switcher (/etc/maze/kernel-default), if that kernel is installed and
    # has a UKI — the same rule maze-sb-sign applies — otherwise the newest.
    # Comparing against the newest unconditionally reported every machine with
    # linux-lts pinned as "DO NOT REBOOT" after a perfectly good driver install.
    pin=""
    [[ -r /etc/maze/kernel-default ]] && pin="$(tr -d '[:space:]' < /etc/maze/kernel-default)"
    if [[ -n "${pin}" ]]; then
        for f in /usr/lib/modules/*/pkgbase; do
            [[ -r "${f}" && "$(cat "${f}")" == "${pin}" ]] || continue
            f="${f%/pkgbase}"; f="${f##*/}"
            if [[ -f "/usr/lib/modules/${f}/vmlinuz" ]] && compgen -G "${esp}/EFI/Linux/*${f}.efi" >/dev/null; then
                kver="${f}"
                log "verify: boot default is pinned to '${pin}' (${kver})"
            fi
            break
        done
    fi

    # maze-sb-sign never hands shim a kernel without the nvidia module: it boots
    # the newest kernel that has the module and a UKI instead (transiently). The
    # expectation here has to follow the same rule, or that correct fallback
    # would be reported as "DO NOT REBOOT".
    if [[ -f /usr/lib/modprobe.d/nvidia-utils.conf ]] && ! modinfo -k "${kver}" -n nvidia >/dev/null 2>&1; then
        for f in $(for gk in /usr/lib/modules/*/; do
                       [[ -f "${gk}vmlinuz" ]] || continue
                       gk="${gk%/}"; printf '%s\n' "${gk##*/}"
                   done | sort -rV); do
            [[ "${f}" == "${kver}" ]] && continue
            modinfo -k "${f}" -n nvidia >/dev/null 2>&1 || continue
            compgen -G "${esp}/EFI/Linux/*${f}.efi" >/dev/null || continue
            log "verify: ${kver} has no NVIDIA module — expecting maze-sb-sign's fallback ${f}"
            kver="${f}"
            break
        done
    fi

    # 1) The ESP must carry a UKI for the kernel that is expected to boot.
    uki=""
    for f in "${esp}"/EFI/Linux/*"${kver}".efi; do
        if [[ -f "${f}" ]]; then uki="${f}"; fi
    done
    if [[ -z "${uki}" ]]; then
        warn "verify: no UKI on the ESP for kernel ${kver} (looked in ${esp}/EFI/Linux)"
        rc=1
    else
        log "verify: UKI present for ${kver} — $(basename "${uki}")"
    fi

    # 2) Under the shim chain, grubx64.efi is what actually boots. It is a
    #    SEPARATE copy of the UKI, so a correct EFI/Linux says nothing about it.
    grub="${esp}/EFI/BOOT/grubx64.efi"
    if [[ -f "${grub}" ]]; then
        gk=""
        if command -v objcopy >/dev/null 2>&1; then
            gk="$(objcopy -O binary --only-section=.uname "${grub}" /dev/stdout 2>/dev/null \
                    | tr -d '\0' | tr -d '[:space:]')"
        fi
        if [[ -z "${gk}" ]]; then
            gk="$(grep -aoE '[0-9]+\.[0-9]+\.[0-9]+-arch[0-9]+-[0-9]+' "${grub}" 2>/dev/null | sort -u | head -1)"
        fi
        if [[ "${gk}" == "${kver}" ]]; then
            log "verify: grubx64.efi boots ${kver} — matches the installed kernel"
        elif [[ -n "${gk}" ]]; then
            warn "verify: grubx64.efi boots ${gk}, but the installed kernel is ${kver}"
            if [[ ! -d "/usr/lib/modules/${gk}" ]]; then
                warn "verify: ${gk} has NO modules on disk — this machine would NOT boot"
            fi
            rc=1
        else
            warn "verify: could not read a kernel version out of grubx64.efi"
            rc=1
        fi
    fi

    MAZE_VERIFIED_KVER="${kver}"
    return "${rc}"
}

# We set up signing whenever a per-machine MOK key exists (i.e. the installer
# configured Secure Boot), even if SB happens to be OFF right now — so enabling
# it later just works.
mok_present() { [[ -r "${MOK_KEY}" && -r "${MOK_CRT}" ]]; }

if [[ "${MODE}" == "ask" ]]; then
    echo
    log "Detected GPU(s):"
    lspci 2>/dev/null | grep -iE 'VGA|3D|Display' | sed 's/^/    /'
    echo
    if has_nvidia_gpu; then
        log "An NVIDIA GPU was detected."
    else
        warn "No NVIDIA GPU detected. The proprietary driver is only for NVIDIA cards."
    fi
    echo "  Maze uses OPEN-SOURCE drivers by default (recommended)."
    echo
    read -rp "Install the NVIDIA proprietary driver now? [y/N] " ans
    case "${ans}" in [yY]*) MODE="nvidia"; MODE_ASKED=1 ;; *) log "Keeping open-source drivers. Nothing to do."; exit 0 ;; esac
fi

# ---------------------------------------------------------------------------
revert_to_open() {
    local exit_code="${1:-0}"
    log "Removing the proprietary NVIDIA driver (reverting to open-source)"
    # Only what is actually installed: one missing name ("target not found")
    # makes pacman abort the WHOLE -Rns — and cuda/ollama-cuda are best-effort
    # extras that are often absent — so the driver stayed installed while the
    # rest of this function went on to delete its configuration.
    local _nv=() _p
    # nvidia-open-dkms is what pacman actually installs for Turing and newer
    # (it provides nvidia-dkms). `pacman -Q nvidia-dkms` does not resolve a
    # provider, so with only the old name here the kernel module package was
    # silently left installed — and with it nvidia-utils' nouveau blacklist.
    for _p in nvidia-open nvidia-open-lts nvidia-open-dkms nvidia-dkms nvidia-utils lib32-nvidia-utils cuda ollama-cuda; do
        pacman -Qq "${_p}" >/dev/null 2>&1 && _nv+=("${_p}")
    done
    if ((${#_nv[@]})); then
        pacman -Rns --noconfirm "${_nv[@]}" \
            || die "could not remove ${_nv[*]} — nothing else was changed. Check the pacman output above."
    else
        log "no proprietary NVIDIA packages are installed"
    fi
    rm -f /etc/modprobe.d/nvidia.conf
    # Drop nvidia from initramfs MODULES.
    if [[ -f /etc/mkinitcpio.conf ]]; then
        # Scoped to the MODULES line (the old pattern ran over the WHOLE file)
        # and matches the trailing '?' the install path now writes.
        sed -i -E '/^[[:space:]]*MODULES=/ s/[[:space:]]*nvidia(_modeset|_uvm|_drm)?\??//g' \
            /etc/mkinitcpio.conf || true
    fi
    # Back on nouveau: if it owns the panel, `kms` is the only thing that puts
    # the splash on the real GPU again (the install path removed it).
    panel_is_nvidia && restore_kms_hook
    rebuild_ukis
    # command -v, not a hardcoded path: the packaged binary lives at
    # /usr/bin/maze-sb-sign (maze-secureboot). /usr/local/bin/maze-sb-sign is
    # only a compat shim the package's .install scriptlet creates when
    # migrating a machine that already had a file there from a pre-package
    # installer — on every fresh install there is nothing at that path at
    # all (".install"'s own _install_shim: "a machine installed from a new
    # ISO has nothing at the old path and gets no shim"), so this check was
    # false on every fresh Maze Linux install and silently skipped re-signing
    # after every driver revert.
    command -v maze-sb-sign >/dev/null 2>&1 && maze-sb-sign --force-bootloader || true
    log "Reverted to open-source drivers. Reboot to apply."
    exit "${exit_code}"
}
[[ "${MODE}" == "open" ]] && revert_to_open

# ---------------------------------------------------------------------------
# NVIDIA proprietary install.
has_nvidia_gpu || warn "no NVIDIA GPU detected — installing anyway as requested"

# 0) Can the open kernel modules drive this card at all? Checked before
#    anything is installed or configured, so a refusal changes nothing.
classify_nvidia_gpus
if ((${#nv_legacy[@]})) && ((${#nv_supported[@]} == 0)); then
    die "this NVIDIA GPU is older than Turing (PCI ${nv_legacy[*]}).

Since driver 590 Arch ships only NVIDIA's open kernel modules, which need an
RTX 20xx / GTX 16xx or newer card. On this one the driver would not load, and
nvidia-utils would still blacklist nouveau: a black screen after the reboot.
Nothing was changed — the open-source driver (nouveau) stays in use.

The last branch that supports this card is the legacy 580xx driver in the AUR
(nvidia-580xx-dkms). Maze does not install it: it is not maintained by Arch,
and future kernels will stop building it."
fi
if ((${#nv_legacy[@]})); then
    warn "an older NVIDIA GPU is also present and will NOT be driven: ${nv_legacy[*]}"
fi

plan_module_packages

# 1) Secure Boot: only the DKMS path builds modules on this machine, so only it
#    is configured to sign them with the MOK — BEFORE building, so they are
#    signed the moment they are built. The prebuilt modules come from Arch.
if [[ "${NV_MODE}" == "dkms" ]]; then
    if mok_present; then
        log "Secure Boot key found — configuring DKMS to sign modules with the MOK"
        install -d -m755 /etc/dkms
        # dkms (>=3.0) reads these from framework.conf and signs every built module.
        if ! grep -q '^mok_signing_key=' /etc/dkms/framework.conf 2>/dev/null; then
            {
                echo "# Maze Linux: sign DKMS modules with the per-machine Secure Boot MOK key"
                echo "mok_signing_key=\"${MOK_KEY}\""
                echo "mok_certificate=\"${MOK_CRT}\""
            } >> /etc/dkms/framework.conf
        fi
    else
        warn "no per-machine MOK key (${MOK_KEY}); DKMS modules will be UNSIGNED."
    fi
fi

# 2) Install the module package(s) + userspace.
#    -Syu (FULL sync) not -Sy: the module and the kernel must match, and a
#    partial upgrade (-Sy + install) is the classic way to break Arch.
if [[ "${NV_MODE}" == "prebuilt" ]]; then
    log "Installing the NVIDIA driver: ${nv_pkgs[*]} (prebuilt by Arch for each kernel — nothing is compiled here)"
else
    log "Installing the NVIDIA driver via DKMS (a non-Arch kernel is installed): ${nv_pkgs[*]} ${nv_hdrs[*]}"
fi

if [[ "${NV_MODE}" == "prebuilt" ]] && pacman -Qq nvidia-open-dkms >/dev/null 2>&1; then
    # Moving a DKMS install onto the prebuilt modules. nvidia-open-dkms
    # conflicts with nvidia-open, and `pacman --noconfirm` answers a conflict
    # question with "no", so a plain -S aborts. Done in steps that each leave a
    # working system: bring everything current and DOWNLOAD the new packages
    # first (a network failure changes nothing), then swap from the cache, and
    # put the DKMS package straight back if the swap does not go through.
    log "Switching from DKMS to the prebuilt modules"
    pacman -Syu --noconfirm \
        || die "system update failed (need internet / a full mirror). Nothing was switched."
    pacman -Sw --noconfirm "${nv_pkgs[@]}" \
        || die "could not download ${nv_pkgs[*]}. Nothing was switched; the DKMS driver stays."
    pacman -Rdd --noconfirm nvidia-open-dkms \
        || die "could not remove nvidia-open-dkms. Nothing was switched."
    if ! pacman -S --noconfirm "${nv_pkgs[@]}"; then
        warn "installing ${nv_pkgs[*]} failed — restoring nvidia-open-dkms"
        pacman -S --noconfirm nvidia-open-dkms \
            || die "could NOT restore nvidia-open-dkms either. DO NOT REBOOT. Run: sudo pacman -S nvidia-open-dkms"
        die "switch to the prebuilt modules failed; the DKMS driver was restored."
    fi
    # Mark the userspace as explicitly wanted, as a fresh install would.
    pacman -S --needed --noconfirm nvidia-utils lib32-nvidia-utils \
        || warn "nvidia-utils / lib32-nvidia-utils could not be (re)confirmed"
    if [[ -z "$(dkms status 2>/dev/null)" ]]; then
        log "no DKMS modules remain; dkms and the kernel headers are no longer needed by the driver"
        log "  (remove them if nothing else uses them: sudo pacman -Rns dkms linux-headers linux-lts-headers)"
    fi
else
    pacman -Syu --needed --noconfirm "${nv_pkgs[@]}" nvidia-utils lib32-nvidia-utils "${nv_hdrs[@]}" \
        || die "package install failed (need internet / a full mirror). Nothing changed permanently."
fi

# 2b) Is the module really there for every kernel? pacman reports success when
#     the packages are installed, whatever DKMS did afterwards — and
#     nvidia-utils blacklists nouveau regardless. On the prebuilt path a gap
#     means Arch has not yet rebuilt the module for a just-released kernel.
nv_built=(); nv_failed=()
for _d in /usr/lib/modules/*/; do
    [[ -f "${_d}pkgbase" && -f "${_d}vmlinuz" ]] || continue
    _k="${_d%/}"; _k="${_k##*/}"
    if modinfo -k "${_k}" nvidia >/dev/null 2>&1; then
        nv_built+=("${_k}")
    else
        nv_failed+=("${_k}")
    fi
done

show_dkms_log() {
    [[ "${NV_MODE}" == "dkms" ]] || return 0
    local log_file
    log_file="$(ls -t /var/lib/dkms/nvidia/*/build/make.log 2>/dev/null | head -1)"
    [[ -n "${log_file}" ]] || return 0
    warn "last lines of ${log_file}:"
    tail -n 12 "${log_file}" | sed 's/^/    /' >&2
}

if ((${#nv_built[@]} == 0)); then
    warn "the NVIDIA module is not available for ANY installed kernel (${nv_failed[*]})."
    show_dkms_log
    warn "Leaving it installed would blacklist nouveau with nothing to replace it,"
    warn "so the open-source driver is being restored. Try again after the next"
    warn "nvidia or kernel update: sudo maze-gpu-driver"
    revert_to_open 1
fi

if ((${#nv_failed[@]})); then
    warn "the NVIDIA module is not available for: ${nv_failed[*]}"
    show_dkms_log
    # No pin is written any more. maze-sb-sign boots the newest kernel that has
    # the module until this one gets it, then moves back by itself — a pin
    # written here used to keep the machine on the older kernel for good.
    log "maze-sb-sign boots a kernel that has the module (${nv_built[*]}) until it"
    log "  is available for ${nv_failed[*]}, then switches back automatically."
fi

# CUDA + ollama-cuda (best-effort, separate call): a slow mirror or offline
# build should not fail the NVIDIA driver install itself over this extra
# download. Without it, ollama silently keeps running CPU-only.
#
# Asked separately when interactive: it is ~3 GB to download and ~6.5 GB on
# disk, and on a small card (2-4 GB VRAM) the speed-up for Maze AI is modest.
want_cuda="y"
if [[ -t 0 && "${MODE_ASKED:-0}" == 1 ]]; then
    read -rp "Also install CUDA + ollama-cuda so Maze AI runs on the GPU (~3 GB download, ~6.5 GB on disk)? [Y/n] " want_cuda
    want_cuda="${want_cuda:-y}"
fi
if [[ "${want_cuda}" != [yY]* ]]; then
    log "skipping CUDA; Maze AI stays on the CPU (later: sudo pacman -S cuda ollama-cuda)"
elif pacman -Syu --needed --noconfirm cuda ollama-cuda; then
    log "CUDA + ollama-cuda installed — ollama will use the GPU"
else
    warn "cuda/ollama-cuda install failed (offline/slow mirror?); ollama stays CPU-only for now"
    warn "retry later with: sudo pacman -S cuda ollama-cuda"
fi

# 3) Early-KMS + power management (same tuning the Maze installer applies).
log "Configuring early KMS and NVIDIA power management"
cat > /etc/modprobe.d/nvidia.conf <<'EOF'
# Maze Linux NVIDIA tuning.
options nvidia_drm modeset=1 fbdev=1
options nvidia NVreg_EnableGpuFirmware=1
options nvidia NVreg_PreserveVideoMemoryAllocations=1   # suspend-to-RAM (Maze does not hibernate)
options nvidia NVreg_UsePageAttributeTable=1
blacklist nouveau
options nouveau modeset=0
EOF
# The nvidia modules are deliberately NOT put into mkinitcpio MODULES. This
# script used to add them (as `nvidia? …`, optional so a missing DKMS build could
# not break `kernel-install`), and the installer's deploy-to-target.sh then
# stripped them again at the next deploy — the two disagreed, and the price of
# "early KMS on the dGPU" was the whole /usr/lib/firmware/nvidia GSP tree in the
# UKI (~214 MB, 240 MB signed image, ~6 s of loader time on every boot for shim
# to read and hash it). Nothing needed to mount root lives on the GPU: nvidia
# loads from the real root a moment after switch-root, and nvidia-drm.modeset=1
# (set below) gives KMS from that point on. The installer already picks the
# panel's driver (i915/amdgpu) for the initramfs; leave MODULES alone here and
# just make sure no stale nvidia/nouveau entries from an older Maze survive.
if [[ -f /etc/mkinitcpio.conf ]]; then
    sed -i -E '/^[[:space:]]*MODULES=/ s/[[:space:]]*\b(nouveau|nvidia(_modeset|_uvm|_drm)?)\b\??//g' \
        /etc/mkinitcpio.conf || warn "could not clean mkinitcpio MODULES"
fi
# On a desktop where the NVIDIA card IS the panel, the installer (which ran on
# the nouveau live medium) kept `kms`; now that nouveau is blacklisted the hook
# is ~110 MB of dead weight in every UKI — see drop_kms_hook().
panel_is_nvidia && drop_kms_hook
# nvidia-hibernate.service is intentionally left out: Maze cannot hibernate.
# There is no swap partition (the installer does not offer one), so no `resume`
# hook and no `resume=` on the cmdline, and the everyday swap is zram — which
# lives in RAM and can never hold a hibernation image. Suspend-to-RAM works and
# is what these two units cover.
systemctl enable nvidia-suspend.service nvidia-resume.service >/dev/null 2>&1 || \
    warn "could not enable nvidia suspend/resume services"

# 4) Kernel param nvidia-drm.modeset=1 on /etc/kernel/cmdline — the UKI is the
#    only thing Maze boots (layout=uki), and kernel-install reads this file to
#    embed the cmdline in it, so this is the sole place the param needs to go.
NV_PARAMS="nvidia-drm.modeset=1 nvidia-drm.fbdev=1"
mkdir -p /etc/kernel
if [[ -f /etc/kernel/cmdline ]]; then
    # /etc/kernel/cmdline must stay a SINGLE line — append in place, never with
    # >> (which would create a malformed second line after the trailing newline).
    if ! grep -qw 'nvidia-drm.modeset=1' /etc/kernel/cmdline; then
        printf '%s %s\n' "$(tr -d '\n' < /etc/kernel/cmdline)" "${NV_PARAMS}" > /etc/kernel/cmdline
    fi
else
    printf '%s\n' "${NV_PARAMS}" > /etc/kernel/cmdline
fi

# 5) Rebuild the initramfs content AND the actual booted UKI (mkinitcpio -P
#    alone only touches the unused plain /boot/initramfs-*.img — see
#    rebuild_ukis() above), then re-sign for Secure Boot.
log "Rebuilding the boot images (UKI) for every installed kernel"
# kernel-install builds the initramfs itself; a separate `mkinitcpio -P` does
# nothing on Maze (empty presets) except print two misleading warnings.
rebuild_ukis

# What the signature check below actually established. Three states, because
# "could not look" must never be reported as "signed" — the final message at
# the end of this script reads this rather than assuming.
NV_SIGNED_STATE="unknown"

# command -v, not a hardcoded path — see the comment on the same check in
# revert_to_open() above: /usr/local/bin/maze-sb-sign does not exist on a
# fresh install.
if mok_present && command -v maze-sb-sign >/dev/null 2>&1; then
    log "Re-signing boot artifacts for Secure Boot"
    maze-sb-sign --force-bootloader || warn "maze-sb-sign reported problems"
fi
if [[ "${NV_MODE}" == "prebuilt" ]]; then
    NV_SIGNED_STATE="prebuilt"
elif mok_present; then
    # Confirm the freshly built nvidia modules carry a signature.
    #
    # Asked per INSTALLED kernel with -k, never for the RUNNING one. Step 2 of
    # this script is a deliberate full `pacman -Syu`, so it routinely upgrades
    # the kernel — and that upgrade deletes /usr/lib/modules/<running kver>.
    # A bare `modinfo -F signer nvidia` resolves against the running kernel, so
    # from that point it searches a module tree that no longer exists, finds
    # nothing, and reports "does not appear signed" — every single time the
    # driver install brought a new kernel with it, which is the common case.
    # DKMS built the modules for the kernels that are still on disk, so those
    # are the ones worth asking about.
    if command -v modinfo >/dev/null 2>&1; then
        _nv_ok=1
        _nv_seen=0
        for _d in /usr/lib/modules/*/; do
            [[ -f "${_d}pkgbase" ]] || continue
            _k="${_d%/}"; _k="${_k##*/}"
            # Skip kernels DKMS has not built the module for; the "no module
            # anywhere" case is reported separately below.
            modinfo -k "${_k}" nvidia >/dev/null 2>&1 || continue
            _nv_seen=1
            if modinfo -k "${_k}" -F signer nvidia 2>/dev/null | grep -qi 'Maze'; then
                log "nvidia module signed with the Maze MOK key for ${_k} ✔"
            else
                _nv_ok=0
                warn "nvidia module for ${_k} does not appear signed — under Secure Boot it may not load."
                warn "Check: modinfo -k ${_k} -F signer nvidia"
            fi
        done
        if [[ "${_nv_seen}" -eq 0 ]]; then
            warn "no built nvidia module found for any installed kernel — did DKMS run?"
            warn "Check: dkms status"
        elif [[ "${_nv_ok}" -eq 1 ]]; then
            NV_SIGNED_STATE="signed"
        else
            NV_SIGNED_STATE="unsigned"
        fi
    fi
fi

echo
log "Verifying the boot chain before declaring success"
if verify_boot_chain; then
    log "NVIDIA proprietary driver installed. REBOOT to load it."
    # Report what the check above actually found. This used to assert
    # "modules are signed" unconditionally — so a run that had just warned
    # "does not appear signed" four lines earlier ended by claiming the
    # opposite. Saying something unverified is the one habit the rest of this
    # stack is written to avoid (see maze-boot-check's recovery-entry check).
    if mok_present; then
        case "${NV_SIGNED_STATE}" in
            signed)
                log "Secure Boot: modules are signed with your MOK; nothing else to enroll." ;;
            prebuilt)
                log "Secure Boot: the boot chain is signed with your MOK. The prebuilt NVIDIA modules"
                log "  are Arch's (not MOK-signed); Maze does not enforce module signatures, so they load." ;;
            unsigned)
                warn "Secure Boot: at least one nvidia module is NOT signed (see above)."
                warn "  With Secure Boot on, that kernel will boot without the driver."
                warn "  Rebuild and re-sign with: sudo dkms autoinstall && sudo maze-sb-sign --force-bootloader" ;;
            *)
                log "Secure Boot: DKMS is configured to sign with your MOK; the signature could not be read here." ;;
        esac
    fi
    exit 0
fi

# Reaching here means the ESP does not boot the kernel that is installed.
# The packages are on disk and harmless; the boot image is not. Say so instead
# of ending on "REBOOT to load it", which is how this used to brick machines.
_kv="${MAZE_VERIFIED_KVER:-<kver>}"
echo >&2
die "boot chain verification FAILED — DO NOT REBOOT.

The NVIDIA packages installed fine, but the boot image on the ESP does not match
the installed kernel (${_kv}). Rebooting now would start a kernel whose modules
are not on disk: nothing would load, vfat included, so /boot could not even be
mounted to repair it.

Repair from THIS still-running session:
    sudo kernel-install add ${_kv} /usr/lib/modules/${_kv}/vmlinuz
    sudo maze-sb-sign --force-bootloader
    sudo maze-gpu-driver --nvidia          # re-run; it will re-verify

If that does not clear it, undo the driver and reboot on the open-source stack:
    sudo maze-gpu-driver --open"
