#!/usr/bin/env python3
"""
maze-kernel — Maze Linux OLED kernel switcher.

A small, single-purpose companion to the Control Center: it shows every kernel
Maze knows about, which one you are running, and lets you install another one,
remove one you no longer need, or pick which kernel boots by default — all
without opening a terminal.

Nothing privileged happens inside this process. Each action shells out to
`pkexec maze-kernel-helper …`, so the (graphical) polkit prompt is the single
authorisation point and the actual pacman / bootctl work lives in one small,
auditable root helper. Read-only status (installed / running / default) is
gathered locally from /usr/lib/modules and pacman.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys

os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

sys.path.insert(0, "/usr/local/lib/maze")
import maze_ui as ui  # noqa: E402
from maze_i18n import current_language, set_language, tr  # noqa: E402

from PySide6.QtCore import QPoint, QPointF, QProcess, QRectF, Qt  # noqa: E402
from PySide6.QtGui import (  # noqa: E402
    QColor, QFont, QIcon, QPainter, QPen, QRadialGradient, QTextCursor,
)
from PySide6.QtSvg import QSvgRenderer  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QApplication,
    QFrame,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QScrollArea,
    QTextEdit,
    QVBoxLayout,
    QWidget,
)

WIN_W, WIN_H = 920, 700
HELPER = "/usr/local/bin/maze-kernel-helper"
# The app/window icon: Maze's own monochrome white CPU logo, in the same house
# style as maze-hardware/maze-panic (see usr/share/pixmaps/maze-kernel.svg).
APP_ICON = "/usr/share/pixmaps/maze-kernel.svg"
# One white line-art icon per kernel (Tux, hourglass, ensō + bolt, shield),
# drawn for this app; generic.svg covers any kernel outside the catalog.
KERNEL_ICON_DIR = "/usr/share/pixmaps/maze-kernel"

# The kernels Maze offers. Kept in lockstep with maze-kernel-helper's CATALOG.
KERNELS = (
    {
        "pkg": "linux",
        "name": "Linux",
        "tag": "Vanilla · Stable",
        "icon": "linux.svg",
        "desc": "The default Arch kernel. Newest features and the widest "
                "hardware support. Kept as the safe fallback.",
    },
    {
        "pkg": "linux-lts",
        "name": "Linux LTS",
        "tag": "Long-Term Support",
        "icon": "linux-lts.svg",
        "desc": "An older, extra-stable kernel with long-term support. The "
                "reliable choice for servers and troubleshooting.",
    },
    {
        "pkg": "linux-zen",
        "name": "Linux Zen",
        "tag": "Performance · Desktop",
        "icon": "linux-zen.svg",
        "desc": "Tuned by the Zen project for a snappier, lower-latency "
                "desktop. Great for daily driving and gaming.",
    },
    {
        "pkg": "linux-hardened",
        "name": "Linux Hardened",
        "tag": "Security · Mitigations",
        "icon": "linux-hardened.svg",
        "desc": "A security-focused kernel with extra exploit mitigations and "
                "a hardened configuration. Fits Maze's threat model.",
    },
)


# --------------------------------------------------------------------------- #
#  Read-only system state (no privileges required)                            #
# --------------------------------------------------------------------------- #
def _run(cmd: list[str]) -> str:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=8
        ).stdout
    except Exception:  # noqa: BLE001
        return ""


def running_pkgbase() -> str:
    try:
        with open(f"/usr/lib/modules/{os.uname().release}/pkgbase") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def installed_versions() -> dict[str, str]:
    """pkgbase -> installed package version, for every catalogued kernel."""
    out: dict[str, str] = {}
    names = [k["pkg"] for k in KERNELS]
    text = _run(["pacman", "-Q", *names])
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            out[parts[0]] = parts[1]
    return out


DEFAULT_MARKER = "/etc/maze/kernel-default"


def _natural_key(ver: str) -> list:
    """Sort key matching `sort -V` closely enough for uname versions."""
    return [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", ver)]


def installed_kvers() -> dict[str, str]:
    """pkgbase -> uname version, for every kernel with a vmlinuz on disk."""
    out: dict[str, str] = {}
    base = "/usr/lib/modules"
    try:
        entries = os.listdir(base)
    except OSError:
        return out
    for kver in entries:
        d = os.path.join(base, kver)
        if not os.path.isfile(os.path.join(d, "vmlinuz")):
            continue
        try:
            with open(os.path.join(d, "pkgbase")) as fh:
                out[fh.read().strip()] = kver
        except OSError:
            continue
    return out


def default_pkgbase() -> tuple[str | None, bool]:
    """(pkgbase of the default boot kernel, True if pinned by the user).

    Maze boots shim → grubx64.efi (the default kernel's signed UKI); the ESP is
    root-only, so this unprivileged process cannot inspect grubx64.efi directly.
    It mirrors maze-sb-sign's own rule instead: the pkgbase in the
    world-readable marker the helper writes on 'Set as default', if that kernel
    is still installed, otherwise the newest installed kernel.
    """
    kvers = installed_kvers()
    try:
        with open(DEFAULT_MARKER) as fh:
            pin = fh.read().strip()
    except OSError:
        pin = ""
    if pin and pin in kvers:
        return pin, True
    if not kvers:
        return None, False
    newest = max(kvers.items(), key=lambda kv: _natural_key(kv[1]))
    return newest[0], False


# --------------------------------------------------------------------------- #
#  Widgets                                                                     #
# --------------------------------------------------------------------------- #
def _badge(text: str, color: str) -> QLabel:
    # str.upper() maps Turkish "i" to "I" ("KURULABILIR"); dotted İ first.
    if current_language() == "tr":
        text = text.replace("i", "İ")
    lab = QLabel(text.upper())
    lab.setStyleSheet(
        f"color: {color}; background: rgba(255,255,255,0.05);"
        f" border: 1px solid {color}; border-radius: 8px;"
        " padding: 2px 8px;"
    )
    lab.setFont(QFont("Sans Serif", 8, QFont.Bold))
    return lab


def _action_button(text: str, kind: str) -> QPushButton:
    """kind: 'primary' (accent), 'ghost' (subtle) or 'danger' (red)."""
    btn = QPushButton(text)
    btn.setCursor(Qt.PointingHandCursor)
    btn.setFixedHeight(34)
    if kind == "primary":
        btn.setStyleSheet(
            f"""
            QPushButton {{ color: #0a0a0c; background: {ui.ACCENT}; border: none;
                           border-radius: 9px; padding: 0 16px;
                           font-size: 10pt; font-weight: bold; }}
            QPushButton:hover {{ background: {ui.ACCENT_HOVER}; }}
            QPushButton:disabled {{ color: {ui.FAINT};
                                    background: rgba(255,255,255,0.06); }}
            """
        )
    elif kind == "danger":
        btn.setStyleSheet(
            f"""
            QPushButton {{ color: {ui.BAD_RED}; background: rgba(224,102,102,0.10);
                           border: 1px solid rgba(224,102,102,0.45);
                           border-radius: 9px; padding: 0 16px; font-size: 10pt; }}
            QPushButton:hover {{ color: #fff; background: rgba(224,102,102,0.30); }}
            QPushButton:disabled {{ color: {ui.FAINT}; border-color:
                                    rgba(255,255,255,0.10); background: transparent; }}
            """
        )
    else:  # ghost
        btn.setStyleSheet(
            f"""
            QPushButton {{ color: {ui.TEXT}; background: {ui.PILL_BG_HOVER};
                           border: none; border-radius: 9px; padding: 0 16px;
                           font-size: 10pt; }}
            QPushButton:hover {{ background: rgba(255,255,255,0.20); }}
            QPushButton:disabled {{ color: {ui.FAINT}; background: {ui.PILL_BG}; }}
            """
        )
    return btn


def kernel_meta(pkg: str) -> dict | None:
    return next((k for k in KERNELS if k["pkg"] == pkg), None)


class KernelEmblem(QWidget):
    """A round glass medallion with the kernel's own icon and a state ring.

    ring: 'running' (green), 'default' (bright white) or '' (faint)."""

    def __init__(self, icon_file: str, size: int, ring: str = "",
                 dim: bool = False) -> None:
        super().__init__()
        self.setFixedSize(size, size)
        self._svg = QSvgRenderer(os.path.join(KERNEL_ICON_DIR, icon_file), self)
        if not self._svg.isValid():
            self._svg = QSvgRenderer(os.path.join(KERNEL_ICON_DIR, "generic.svg"), self)
        self._ring = ring
        self._dim = dim   # not installed: drawn quieter than the real choices

    def paintEvent(self, _event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        if self._dim:
            p.setOpacity(0.55)
        r = QRectF(self.rect()).adjusted(1.5, 1.5, -1.5, -1.5)
        glow = QRadialGradient(QPointF(r.center().x(), r.top() + r.height() * 0.3),
                               r.width() * 0.75)
        glow.setColorAt(0.0, QColor(255, 255, 255, 34))
        glow.setColorAt(1.0, QColor(255, 255, 255, 6))
        p.setBrush(glow)
        ring = {"running": QColor(ui.OK_GREEN),
                "default": QColor(255, 255, 255, 190)}.get(
                    self._ring, QColor(255, 255, 255, 38))
        p.setPen(QPen(ring, 1.6 if self._ring else 1.0))
        p.drawEllipse(r)
        if self._svg.isValid():
            s = r.width() * 0.5
            self._svg.render(p, QRectF(r.center().x() - s / 2, r.center().y() - s / 2, s, s))
        p.end()


class KernelCard(QFrame):
    """One kernel: icon, name, live badges, description and its actions."""

    def __init__(self, meta: dict, running: str,
                 installed: dict[str, str], default: str | None,
                 pinned: bool, on_action) -> None:
        super().__init__()
        self._pkg = meta["pkg"]
        self._on_action = on_action
        pkg = meta["pkg"]
        is_installed = pkg in installed
        is_running = pkg == running
        is_default = default is not None and pkg == default

        # The boot default gets a brighter glass edge so the one kernel that
        # will come up next stands out in the list at a glance.
        if is_default:
            bg, border = "rgba(255,255,255,0.075)", "rgba(255,255,255,0.30)"
        elif is_installed:
            bg, border = "rgba(255,255,255,0.045)", "rgba(255,255,255,0.09)"
        else:
            bg, border = "rgba(255,255,255,0.025)", "rgba(255,255,255,0.05)"
        self.setStyleSheet(
            f"QFrame#card {{ background: {bg}; border: 1px solid {border};"
            "               border-radius: 18px; }"
        )
        self.setObjectName("card")
        row = QHBoxLayout(self)
        row.setContentsMargins(18, 16, 20, 16)
        row.setSpacing(18)

        # -- icon medallion --------------------------------------------------
        ring = "running" if is_running else ("default" if is_default else "")
        emblem = KernelEmblem(meta["icon"], 68, ring, dim=not is_installed)
        row.addWidget(emblem, 0, Qt.AlignVCenter)

        # -- text column -----------------------------------------------------
        col = QVBoxLayout()
        col.setSpacing(4)

        title = QHBoxLayout()
        title.setSpacing(9)
        name = QLabel(meta["name"])
        name.setStyleSheet(f"color: {ui.TEXT}; background: transparent;")
        name.setFont(QFont("Sans Serif", 14, QFont.Bold))
        title.addWidget(name)
        if is_running:
            title.addWidget(_badge(tr("Running"), ui.OK_GREEN))
        if is_default:
            title.addWidget(_badge(
                tr("Default") if pinned else tr("Default · auto"),
                ui.ACCENT_HOVER))
        if is_installed and not is_running:
            title.addWidget(_badge(tr("Installed"), ui.DIM))
        if not is_installed:
            title.addWidget(_badge(tr("Available"), ui.FAINT))
        title.addStretch(1)
        col.addLayout(title)

        tagline = QLabel(tr(meta["tag"]))
        tagline.setStyleSheet(
            f"color: {ui.TEXT}; background: rgba(255,255,255,0.07);"
            " border-radius: 7px; padding: 2px 9px;")
        tagline.setFont(QFont("Sans Serif", 8, QFont.Bold))
        tag_row = QHBoxLayout()
        tag_row.setSpacing(0)
        tag_row.addWidget(tagline)
        tag_row.addStretch(1)
        col.addLayout(tag_row)

        desc = QLabel(tr(meta["desc"]))
        desc.setWordWrap(True)
        desc.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        desc.setFont(QFont("Sans Serif", 9))
        col.addWidget(desc)

        pkgline = QLabel(
            f"{pkg}" + (f"  ·  {installed[pkg]}" if is_installed else "")
        )
        pkgline.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        pkgline.setFont(QFont(ui.MONO, 8))
        col.addWidget(pkgline)
        row.addLayout(col, 1)

        # -- action column ---------------------------------------------------
        acts = QVBoxLayout()
        acts.setSpacing(8)
        acts.addStretch(1)
        if not is_installed:
            b = _action_button(tr("Install"), "primary")
            b.clicked.connect(lambda: self._on_action("install", pkg))
            acts.addWidget(b)
        else:
            # The running kernel is not necessarily the boot default (it may
            # have been picked from the firmware's recovery entry), so it can
            # be made the default like any other.
            if not is_default or not pinned:
                b = _action_button(tr("Set as default"), "primary")
                b.clicked.connect(lambda: self._on_action("set-default", pkg))
                acts.addWidget(b)
            rm = _action_button(tr("Remove"), "danger")
            can_remove = not is_running and pkg != "linux"
            rm.setEnabled(can_remove)
            if can_remove:
                rm.clicked.connect(lambda: self._on_action("remove", pkg))
            acts.addWidget(rm)
        acts.addStretch(1)
        row.addLayout(acts, 0)


class RunPanel(QFrame):
    """Overlay that streams a privileged helper run's live output."""

    def __init__(self, parent: QWidget, on_finished) -> None:
        super().__init__(parent)
        self._on_finished = on_finished
        self._proc: QProcess | None = None
        self.setStyleSheet("QFrame { background: rgba(0,0,0,0.72); }")
        self.hide()

        outer = QVBoxLayout(self)
        outer.setContentsMargins(60, 60, 60, 60)

        panel = ui.Glass(None)
        outer.addWidget(panel)
        lay = QVBoxLayout(panel)
        lay.setContentsMargins(26, 24, 26, 22)
        lay.setSpacing(12)

        self._title = ui.heading(tr("Working…"), 16)
        lay.addWidget(self._title)

        self._log = QTextEdit()
        self._log.setReadOnly(True)
        self._log.setFont(QFont(ui.MONO, 9))
        self._log.setStyleSheet(
            f"QTextEdit {{ color: {ui.DIM}; background: rgba(0,0,0,0.55);"
            " border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;"
            " padding: 10px; }"
        )
        lay.addWidget(self._log, 1)

        bar = QHBoxLayout()
        self._status = QLabel("")
        self._status.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        self._status.setFont(QFont("Sans Serif", 10))
        bar.addWidget(self._status)
        bar.addStretch(1)
        self._close = _action_button(tr("Close"), "ghost")
        self._close.setEnabled(False)
        self._close.clicked.connect(self._dismiss)
        bar.addWidget(self._close)
        lay.addLayout(bar)

    def _dismiss(self) -> None:
        self.hide()
        self._on_finished()

    def start(self, verb: str, pkg: str) -> None:
        titles = {
            "install": tr("Installing {pkg}…"),
            "remove": tr("Removing {pkg}…"),
            "set-default": tr("Setting {pkg} as default…"),
            "clear-default": tr("Switching to the newest kernel…"),
        }
        self._title.setText(titles.get(verb, tr("Working…")).format(pkg=pkg))
        self._status.setText(tr("Authorising…"))
        self._status.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        self._log.clear()
        self._close.setText(tr("Close"))
        self._close.setEnabled(False)
        self.resize(self.parent().size())
        self.show()
        self.raise_()

        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(self._read)
        self._proc.finished.connect(self._done)
        self._proc.errorOccurred.connect(self._error)
        self._proc.start("pkexec", [HELPER, verb] + ([pkg] if pkg else []))

    def busy(self) -> bool:
        return (self._proc is not None
                and self._proc.state() != QProcess.NotRunning)

    def _read(self) -> None:
        if self._proc is None:
            return
        data = bytes(self._proc.readAll()).decode("utf-8", "replace")
        if not data:
            return
        self._status.setText(tr("Running…"))
        self._log.moveCursor(QTextCursor.End)
        self._log.insertPlainText(data)
        self._log.moveCursor(QTextCursor.End)
        sb = self._log.verticalScrollBar()
        sb.setValue(sb.maximum())

    def _error(self, err) -> None:
        # FailedToStart never emits finished(), which used to leave the overlay
        # up with its Close button disabled and Esc blocked — a dead window.
        if err == QProcess.FailedToStart:
            self._log.append(tr("Could not start pkexec — is polkit installed?"))
            self._done(-1, None)

    def _done(self, code: int, _status) -> None:
        if code in (126, 127):
            # pkexec: 126 = dialog dismissed, 127 = not authorised. Nothing ran.
            self._log.append("\n" + tr("Authorisation was cancelled or denied — "
                                       "nothing was changed."))
            self._status.setText(tr("Cancelled."))
            self._status.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        elif code == 0:
            self._status.setText("✓  " + tr("Completed successfully."))
            self._status.setStyleSheet(
                f"color: {ui.OK_GREEN}; background: transparent;")
        else:
            self._status.setText("✕  " + tr("Finished with errors."))
            self._status.setStyleSheet(
                f"color: {ui.BAD_RED}; background: transparent;")
        self._close.setEnabled(True)


class KernelSwitcher(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self._drag_offset: QPoint | None = None
        self.setWindowTitle("Maze Kernel Switcher")
        self.setWindowIcon(QIcon(APP_ICON))
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowSystemMenuHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setFixedSize(WIN_W, WIN_H)

        self._root = ui.Glass(ui.make_watermark(), self)
        self._root.setGeometry(0, 0, WIN_W, WIN_H)
        self._outer = QVBoxLayout(self._root)
        self._outer.setContentsMargins(34, 24, 34, 26)
        self._outer.setSpacing(0)
        self._build()

        self._runner = RunPanel(self, self._refresh)

    # -- build / rebuild ------------------------------------------------------
    def _build(self) -> None:
        while self._outer.count():
            item = self._outer.takeAt(0)
            w = item.widget()
            if w is not None:
                w.setParent(None)
                w.deleteLater()
            elif item.layout() is not None:
                self._clear_layout(item.layout())
        self._outer.addLayout(self._header())
        self._outer.addSpacing(14)
        self._outer.addWidget(self._banner())
        self._outer.addSpacing(12)
        self._outer.addWidget(self._list(), 1)
        self._outer.addSpacing(12)
        self._outer.addLayout(self._footer())

    @classmethod
    def _clear_layout(cls, lay) -> None:
        # Recursive: the header nests its title column inside the bar, and a
        # non-recursive clear left those labels painted under the new ones —
        # a doubled title after every refresh or language switch.
        while lay.count():
            it = lay.takeAt(0)
            w = it.widget()
            if w is not None:
                w.setParent(None)
                w.deleteLater()
            elif it.layout() is not None:
                cls._clear_layout(it.layout())
                it.layout().deleteLater()

    def _header(self) -> QHBoxLayout:
        bar = QHBoxLayout()
        logo = QLabel()
        logo.setStyleSheet("background: transparent;")
        pm = ui.logo_pixmap()
        if not pm.isNull():
            logo.setPixmap(
                pm.scaled(40, 40, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        bar.addWidget(logo, 0, Qt.AlignVCenter)
        bar.addSpacing(12)

        titles = QVBoxLayout()
        titles.setSpacing(1)
        t = QLabel(tr("Kernel Switcher"))
        t.setStyleSheet(f"color: {ui.TEXT}; background: transparent;")
        t.setFont(QFont("Sans Serif", 17, QFont.Bold))
        s = QLabel(tr("Install, remove and choose which kernel boots."))
        s.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        s.setFont(QFont("Sans Serif", 10))
        titles.addWidget(t)
        titles.addWidget(s)
        bar.addLayout(titles)
        bar.addStretch(1)

        bar.addWidget(ui.language_toggle(self._set_language), 0, Qt.AlignTop)
        bar.addSpacing(8)
        close = QPushButton("✕")
        close.setCursor(Qt.PointingHandCursor)
        close.setFixedSize(30, 30)
        close.setStyleSheet(
            f"""
            QPushButton {{ color: {ui.DIM}; background: transparent; border: none;
                           font-size: 16px; border-radius: 15px; }}
            QPushButton:hover {{ color: white; background: rgba(224,68,68,0.25); }}
            """
        )
        close.clicked.connect(self.close)
        bar.addWidget(close, 0, Qt.AlignTop)
        return bar

    @staticmethod
    def _banner_half(caption: str, pkg: str | None, detail: str,
                     ring: str) -> QHBoxLayout:
        meta = kernel_meta(pkg or "")
        lay = QHBoxLayout()
        lay.setSpacing(14)
        lay.addWidget(KernelEmblem(meta["icon"] if meta else "generic.svg", 50, ring))
        col = QVBoxLayout()
        col.setSpacing(1)
        lbl = QLabel(caption.upper())
        lbl.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        lbl.setFont(QFont("Sans Serif", 8, QFont.Bold))
        name = QLabel(meta["name"] if meta else (pkg or tr("unknown")))
        name.setStyleSheet(f"color: {ui.TEXT}; background: transparent;")
        name.setFont(QFont("Sans Serif", 14, QFont.Bold))
        det = QLabel(detail)
        det.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        det.setFont(QFont(ui.MONO, 8))
        col.addStretch(1)
        col.addWidget(lbl)
        col.addWidget(name)
        col.addWidget(det)
        col.addStretch(1)
        lay.addLayout(col, 1)
        return lay

    def _banner(self) -> QWidget:
        """Two halves: what runs now, and what the next boot will run."""
        running = running_pkgbase()
        default, pinned = default_pkgbase()
        frame = QFrame()
        frame.setObjectName("banner")
        frame.setStyleSheet(
            "QFrame#banner { background: rgba(255,255,255,0.05);"
            " border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; }")
        lay = QHBoxLayout(frame)
        lay.setContentsMargins(18, 14, 18, 14)
        lay.setSpacing(18)
        lay.addLayout(self._banner_half(
            tr("Currently running"), running, os.uname().release, "running"), 1)

        sep = QFrame()
        sep.setFixedWidth(1)
        sep.setStyleSheet("background: rgba(255,255,255,0.10); border: none;")
        lay.addWidget(sep)

        mode = tr("pinned by you") if pinned else tr("automatic: newest installed")
        lay.addLayout(self._banner_half(
            tr("Boots next"), default, mode, "default"), 1)
        if pinned:
            auto = _action_button(tr("Use newest"), "ghost")
            auto.setToolTip(tr("Clear the pinned default ({pkg}); the newest "
                               "installed kernel will boot from now on."
                               ).format(pkg=default))
            auto.clicked.connect(lambda: self._action("clear-default", ""))
            lay.addWidget(auto, 0, Qt.AlignVCenter)
        return frame

    def _list(self) -> QWidget:
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        scroll.setStyleSheet("""
            QScrollArea { background: transparent; border: none; }
            QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
            QScrollBar::handle:vertical { background: rgba(255,255,255,0.18);
                                          border-radius: 4px; min-height: 32px; }
            QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.32); }
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
            QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
        """)
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        col = QVBoxLayout(inner)
        col.setContentsMargins(0, 0, 8, 0)
        col.setSpacing(10)

        running = running_pkgbase()
        installed = installed_versions()
        default, pinned = default_pkgbase()
        for meta in KERNELS:
            col.addWidget(KernelCard(meta, running, installed, default,
                                     pinned, self._action))
        col.addStretch(1)
        scroll.setWidget(inner)
        return scroll

    def _footer(self) -> QHBoxLayout:
        f = QHBoxLayout()
        hint = QLabel(tr(
            "Installing a kernel builds and signs a Secure-Boot image "
            "automatically. Keep your system updated with pacman -Syu."))
        hint.setWordWrap(True)
        hint.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        hint.setFont(QFont("Sans Serif", 9))
        f.addWidget(hint, 1)
        f.addSpacing(14)
        refresh = _action_button(f"⟳  {tr('Refresh')}", "ghost")
        refresh.setFixedHeight(38)
        refresh.clicked.connect(self._refresh)
        f.addWidget(refresh, 0, Qt.AlignBottom)
        return f

    # -- actions --------------------------------------------------------------
    def _action(self, verb: str, pkg: str) -> None:
        self._runner.start(verb, pkg)

    def _refresh(self) -> None:
        self._build()

    def _set_language(self, code: str) -> None:
        set_language(code)
        self._build()

    # -- window behaviour -----------------------------------------------------
    def show_centered(self) -> None:
        screen = QApplication.primaryScreen().availableGeometry()
        geo = self.frameGeometry()
        geo.moveCenter(screen.center())
        self.move(geo.topLeft())
        self.show()
        ui.enable_kde_blur(int(self.winId()))

    def resizeEvent(self, event) -> None:  # noqa: N802
        if getattr(self, "_runner", None) is not None and self._runner.isVisible():
            self._runner.resize(self.size())
        super().resizeEvent(event)

    def mousePressEvent(self, event) -> None:  # noqa: N802
        if event.button() == Qt.LeftButton and event.position().y() < 70:
            self._drag_offset = event.globalPosition().toPoint() - self.pos()

    def mouseMoveEvent(self, event) -> None:  # noqa: N802
        if self._drag_offset is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self._drag_offset)

    def mouseReleaseEvent(self, event) -> None:  # noqa: N802
        self._drag_offset = None

    def closeEvent(self, event) -> None:  # noqa: N802
        # Alt+F4 / the taskbar would otherwise close us mid-transaction: the
        # helper's stdout pipe breaks and pacman can die on SIGPIPE halfway
        # through installing a kernel.
        if self._runner.busy():
            event.ignore()
            return
        super().closeEvent(event)

    def keyPressEvent(self, event) -> None:  # noqa: N802
        if event.key() == Qt.Key_Escape:
            if self._runner.isVisible():
                return  # don't let Esc close the window mid-operation
            self.close()
            return
        super().keyPressEvent(event)


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Maze Kernel Switcher")
    app.setDesktopFileName("maze-kernel")
    app.setWindowIcon(QIcon(APP_ICON))
    win = KernelSwitcher()
    win.show_centered()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
