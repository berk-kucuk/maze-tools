#!/usr/bin/env python3
"""
maze-kernel — Maze Linux kernel switcher.

A small, single-purpose companion to the Control Center: it shows every kernel
Maze knows about, which one you are running, and lets you install another one,
remove one you no longer need, or pick which kernel boots by default — all
without opening a terminal.

Nothing privileged happens inside this process. Each action shells out to
`pkexec maze-kernel-helper …`, so the (graphical) polkit prompt is the single
authorisation point and the actual pacman / bootctl work lives in one small,
auditable root helper. Read-only status (installed / running / default) is
gathered locally from /usr/lib/modules and pacman.

The window is the same true-black OLED panel as the Control Center and
Welcome (maze_ui's OLED kit): black surface, faint white cards, the logo
watermark. While a helper run is on screen the kernel list is dimmed behind
a black panel, as Welcome does for its info cards.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys

os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

sys.path.insert(0, "/usr/local/lib/maze")
import maze_ui as ui  # noqa: E402
from maze_i18n import set_language, tr  # noqa: E402

from PySide6.QtCore import QPoint, QPointF, QProcess, QRectF, Qt, QTimer  # noqa: E402
from PySide6.QtGui import (  # noqa: E402
    QColor, QFont, QIcon, QPainter, QPainterPath, QPen, QTextCursor,
)
from PySide6.QtWidgets import (  # noqa: E402
    QApplication,
    QFrame,
    QHBoxLayout,
    QLabel,
    QScrollArea,
    QTextEdit,
    QVBoxLayout,
    QWidget,
)

WIN_W, WIN_H = 900, 856
HELPER = "/usr/local/bin/maze-kernel-helper"
# The app/window icon: a white chip with a swap arrow, in the same house style
# as maze-hardware/maze-panic (see usr/share/pixmaps/maze-kernel.svg).
APP_ICON = "/usr/share/pixmaps/maze-kernel.svg"
# One white line-art icon per kernel (Tux, hourglass, ensō + bolt, shield) on
# the same 24px grid as maze-hardware's; generic.svg covers any kernel outside
# the catalog.
KERNEL_ICON_DIR = "/usr/share/pixmaps/maze-kernel"

# The kernels Maze offers. Kept in lockstep with maze-kernel-helper's CATALOG.
KERNELS = (
    {
        "pkg": "linux",
        "name": "Linux",
        "tag": "Vanilla · Stable",
        "icon": "linux.svg",
        "desc": "The default Arch kernel. Newest features and the widest "
                "hardware support. Kept as the safe fallback.",
    },
    {
        "pkg": "linux-lts",
        "name": "Linux LTS",
        "tag": "Long-Term Support",
        "icon": "linux-lts.svg",
        "desc": "An older, extra-stable kernel with long-term support. The "
                "reliable choice for servers and troubleshooting.",
    },
    {
        "pkg": "linux-zen",
        "name": "Linux Zen",
        "tag": "Performance · Desktop",
        "icon": "linux-zen.svg",
        "desc": "Tuned by the Zen project for a snappier, lower-latency "
                "desktop. Great for daily driving and gaming.",
    },
    {
        "pkg": "linux-hardened",
        "name": "Linux Hardened",
        "tag": "Security · Mitigations",
        "icon": "linux-hardened.svg",
        "desc": "A security-focused kernel with extra exploit mitigations and "
                "a hardened configuration. Fits Maze's threat model.",
    },
)


# --------------------------------------------------------------------------- #
#  Read-only system state (no privileges required)                            #
# --------------------------------------------------------------------------- #
def _run(cmd: list[str]) -> str:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=8
        ).stdout
    except Exception:  # noqa: BLE001
        return ""


def running_pkgbase() -> str:
    try:
        with open(f"/usr/lib/modules/{os.uname().release}/pkgbase") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def installed_versions() -> dict[str, str]:
    """pkgbase -> installed package version, for every catalogued kernel."""
    out: dict[str, str] = {}
    names = [k["pkg"] for k in KERNELS]
    text = _run(["pacman", "-Q", *names])
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            out[parts[0]] = parts[1]
    return out


DEFAULT_MARKER = "/etc/maze/kernel-default"


def _natural_key(ver: str) -> list:
    """Sort key matching `sort -V` closely enough for uname versions."""
    return [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", ver)]


def installed_kvers() -> dict[str, str]:
    """pkgbase -> uname version, for every kernel with a vmlinuz on disk."""
    out: dict[str, str] = {}
    base = "/usr/lib/modules"
    try:
        entries = os.listdir(base)
    except OSError:
        return out
    for kver in entries:
        d = os.path.join(base, kver)
        if not os.path.isfile(os.path.join(d, "vmlinuz")):
            continue
        try:
            with open(os.path.join(d, "pkgbase")) as fh:
                out[fh.read().strip()] = kver
        except OSError:
            continue
    return out


def default_pkgbase() -> tuple[str | None, bool]:
    """(pkgbase of the default boot kernel, True if pinned by the user).

    Maze boots shim → grubx64.efi (the default kernel's signed UKI); the ESP is
    root-only, so this unprivileged process cannot inspect grubx64.efi directly.
    It mirrors maze-sb-sign's own rule instead: the pkgbase in the
    world-readable marker the helper writes on 'Set as default', if that kernel
    is still installed, otherwise the newest installed kernel.
    """
    kvers = installed_kvers()
    try:
        with open(DEFAULT_MARKER) as fh:
            pin = fh.read().strip()
    except OSError:
        pin = ""
    if pin and pin in kvers:
        return pin, True
    if not kvers:
        return None, False
    newest = max(kvers.items(), key=lambda kv: _natural_key(kv[1]))
    return newest[0], False


# --------------------------------------------------------------------------- #
#  Widgets                                                                     #
# --------------------------------------------------------------------------- #
def kernel_meta(pkg: str) -> dict | None:
    return next((k for k in KERNELS if k["pkg"] == pkg), None)


def kernel_icon(meta: dict | None) -> str:
    path = os.path.join(KERNEL_ICON_DIR, meta["icon"]) if meta else ""
    return path if path and os.path.isfile(path) else os.path.join(
        KERNEL_ICON_DIR, "generic.svg")


class Spinner(QWidget):
    """A small rotating arc; stop() freezes it into a status glyph."""

    def __init__(self, size: int = 22) -> None:
        super().__init__()
        self.setFixedSize(size, size)
        self._angle = 0
        self._result: str | None = None   # None = spinning, 'ok', 'fail', 'idle'
        self._timer = QTimer(self)
        self._timer.setInterval(16)
        self._timer.timeout.connect(self._tick)

    def _tick(self) -> None:
        self._angle = (self._angle + 8) % 360
        self.update()

    def start(self) -> None:
        self._result = None
        self._timer.start()
        self.update()

    def stop(self, result: str) -> None:
        self._result = result
        self._timer.stop()
        self.update()

    def paintEvent(self, _event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        r = QRectF(self.rect()).adjusted(2, 2, -2, -2)
        if self._result is None:
            p.setPen(QPen(QColor(255, 255, 255, 40), 2.2))
            p.drawEllipse(r)
            p.setPen(QPen(QColor(ui.TEXT), 2.2, Qt.SolidLine, Qt.RoundCap))
            p.drawArc(r, -self._angle * 16, 100 * 16)
        else:
            color = {"ok": QColor(ui.OK_GREEN), "fail": QColor(ui.BAD_RED)}.get(
                self._result, QColor(ui.DIM))
            p.setPen(Qt.NoPen)
            p.setBrush(QColor(color.red(), color.green(), color.blue(), 45))
            p.drawEllipse(r)
            p.setPen(QPen(color, 2.0, Qt.SolidLine, Qt.RoundCap, Qt.RoundJoin))
            c, k = r.center(), r.width() * 0.2
            if self._result == "ok":
                p.drawPolyline([QPointF(c.x() - k, c.y()),
                                QPointF(c.x() - k * 0.25, c.y() + k * 0.8),
                                QPointF(c.x() + k * 1.1, c.y() - k * 0.7)])
            elif self._result == "fail":
                p.drawLine(QPointF(c.x() - k, c.y() - k), QPointF(c.x() + k, c.y() + k))
                p.drawLine(QPointF(c.x() + k, c.y() - k), QPointF(c.x() - k, c.y() + k))
            else:
                p.drawLine(QPointF(c.x() - k, c.y()), QPointF(c.x() + k, c.y()))
        p.end()


class FlowArrow(QWidget):
    """The faint → between 'running now' and 'boots next' in the summary."""

    def __init__(self) -> None:
        super().__init__()
        self.setFixedSize(44, 32)

    def paintEvent(self, _event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        y = self.height() / 2
        p.setPen(QPen(QColor(255, 255, 255, 70), 1.6, Qt.SolidLine, Qt.RoundCap,
                      Qt.RoundJoin))
        p.drawLine(QPointF(6, y), QPointF(self.width() - 7, y))
        p.drawPolyline([QPointF(self.width() - 12, y - 5),
                        QPointF(self.width() - 7, y),
                        QPointF(self.width() - 12, y + 5)])
        p.end()


class KernelCard(ui.GlassCard):
    """One kernel: icon, name, live chips, tagline, description and actions."""

    def __init__(self, meta: dict, running: str,
                 installed: dict[str, str], default: str | None,
                 pinned: bool, on_action) -> None:
        super().__init__(radius=14)
        pkg = meta["pkg"]
        is_installed = pkg in installed
        is_running = pkg == running
        is_default = default is not None and pkg == default
        # The kernel that boots next gets a brighter rim so it stands
        # out in the list at a glance.
        self.set_emphasis(is_default)

        row = QHBoxLayout(self)
        row.setContentsMargins(18, 14, 20, 14)
        row.setSpacing(18)

        tile = ui.IconTile(kernel_icon(meta), 60)
        tile.set_state(dim=not is_installed,
                       dot=QColor(ui.OK_GREEN) if is_running else None)
        row.addWidget(tile, 0, Qt.AlignVCenter)

        # -- text column -----------------------------------------------------
        col = QVBoxLayout()
        col.setSpacing(3)
        title = QHBoxLayout()
        title.setSpacing(8)
        title.addWidget(ui.label(meta["name"], 13.5,
                                 ui.TEXT if is_installed else ui.DIM, QFont.DemiBold))
        title.addSpacing(2)
        if is_running:
            title.addWidget(ui.chip(tr("Running"), ui.OK_GREEN), 0, Qt.AlignVCenter)
        if is_default:
            title.addWidget(ui.chip(tr("Default") if pinned else tr("Default · auto"),
                                    "#ffffff"), 0, Qt.AlignVCenter)
        if is_installed and not is_running and not is_default:
            title.addWidget(ui.chip(tr("Installed"), ui.DIM, dot=False), 0, Qt.AlignVCenter)
        if not is_installed:
            title.addWidget(ui.chip(tr("Available"), ui.FAINT, dot=False), 0, Qt.AlignVCenter)
        title.addStretch(1)
        col.addLayout(title)
        col.addWidget(ui.label(ui.caps(tr(meta["tag"])), 7.5, ui.FAINT, QFont.Bold, 1.1))
        col.addSpacing(3)
        desc = ui.label(tr(meta["desc"]), 9.5, ui.DIM)
        desc.setWordWrap(True)
        col.addWidget(desc)
        pkgline = QLabel(pkg + (f"  ·  {installed[pkg]}" if is_installed else ""))
        pkgline.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        pkgline.setFont(QFont(ui.MONO, 8))
        pkgline.setTextInteractionFlags(Qt.TextSelectableByMouse)
        col.addSpacing(2)
        col.addWidget(pkgline)
        row.addLayout(col, 1)

        # -- action column ---------------------------------------------------
        acts = QVBoxLayout()
        acts.setSpacing(8)
        acts.addStretch(1)
        if not is_installed:
            b = ui.pill_button(tr("Install"), "primary")
            b.clicked.connect(lambda: on_action("install", pkg))
            acts.addWidget(b)
        else:
            # The running kernel is not necessarily the boot default (it may
            # have been picked from the firmware's recovery entry), so it can
            # be made the default like any other.
            if not is_default or not pinned:
                b = ui.pill_button(tr("Set as default"), "primary")
                b.clicked.connect(lambda: on_action("set-default", pkg))
                acts.addWidget(b)
            rm = ui.pill_button(tr("Remove"), "danger")
            can_remove = not is_running and pkg != "linux"
            rm.setEnabled(can_remove)
            if can_remove:
                rm.clicked.connect(lambda: on_action("remove", pkg))
            acts.addWidget(rm)
        acts.addStretch(1)
        row.addLayout(acts, 0)


class RunPanel(QWidget):
    """Overlay that streams a privileged helper run's live output.

    While it is up, the window behind it is dimmed to near-black and the run
    sits on a solid black panel in front — Welcome's info-card overlay.
    """

    def __init__(self, parent: QWidget, on_finished) -> None:
        super().__init__(parent)
        self._on_finished = on_finished
        self._proc: QProcess | None = None
        self.hide()

        outer = QVBoxLayout(self)
        outer.setContentsMargins(70, 70, 70, 70)
        panel = QFrame()
        panel.setObjectName("runpanel")
        panel.setStyleSheet(
            f"QFrame#runpanel {{ background: {ui.PANEL_BLACK}; border-radius: 18px;"
            " border: 1px solid rgba(255,255,255,0.14); }")
        outer.addWidget(panel)
        lay = QVBoxLayout(panel)
        lay.setContentsMargins(26, 24, 26, 22)
        lay.setSpacing(14)

        top = QHBoxLayout()
        top.setSpacing(14)
        self._spinner = Spinner(26)
        top.addWidget(self._spinner, 0, Qt.AlignVCenter)
        titles = QVBoxLayout()
        titles.setSpacing(2)
        self._title = ui.label(tr("Working…"), 15, ui.TEXT, QFont.Bold)
        self._status = ui.label("", 9.5, ui.DIM)
        titles.addWidget(self._title)
        titles.addWidget(self._status)
        top.addLayout(titles, 1)
        lay.addLayout(top)

        self._log = QTextEdit()
        self._log.setReadOnly(True)
        self._log.setFont(QFont(ui.MONO, 9))
        self._log.setStyleSheet(
            f"QTextEdit {{ color: {ui.DIM}; background: rgba(255,255,255,0.03);"
            " border: 1px solid rgba(255,255,255,0.07); border-radius: 12px;"
            " padding: 12px; }"
            "QScrollBar:vertical { background: transparent; width: 8px; margin: 4px; }"
            "QScrollBar::handle:vertical { background: rgba(255,255,255,0.18);"
            " border-radius: 4px; min-height: 32px; }"
            "QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }"
            "QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical"
            " { background: transparent; }")
        lay.addWidget(self._log, 1)

        bar = QHBoxLayout()
        bar.addStretch(1)
        self._close = ui.pill_button(tr("Close"), "ghost")
        self._close.setMinimumWidth(110)
        self._close.setEnabled(False)
        self._close.clicked.connect(self._dismiss)
        bar.addWidget(self._close)
        lay.addLayout(bar)

    def paintEvent(self, _event) -> None:  # noqa: N802
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        path = QPainterPath()
        path.addRoundedRect(QRectF(self.rect()), ui.GLASS_RADIUS, ui.GLASS_RADIUS)
        p.fillPath(path, QColor(0, 0, 0, 205))
        p.end()

    def _set_status(self, text: str, color: str) -> None:
        self._status.setText(text)
        self._status.setStyleSheet(f"color: {color}; background: transparent;")

    def _dismiss(self) -> None:
        self.hide()
        self._on_finished()

    def start(self, verb: str, pkg: str) -> None:
        titles = {
            "install": tr("Installing {pkg}…"),
            "remove": tr("Removing {pkg}…"),
            "set-default": tr("Setting {pkg} as default…"),
            "clear-default": tr("Switching to the newest kernel…"),
        }
        self._title.setText(titles.get(verb, tr("Working…")).format(pkg=pkg))
        self._set_status(tr("Authorising…"), ui.DIM)
        self._spinner.start()
        self._log.clear()
        self._close.setEnabled(False)
        self.resize(self.parent().size())
        self.show()
        self.raise_()

        self._proc = QProcess(self)
        self._proc.setProcessChannelMode(QProcess.MergedChannels)
        self._proc.readyRead.connect(self._read)
        self._proc.finished.connect(self._done)
        self._proc.errorOccurred.connect(self._error)
        self._proc.start("pkexec", [HELPER, verb] + ([pkg] if pkg else []))

    def busy(self) -> bool:
        return (self._proc is not None
                and self._proc.state() != QProcess.NotRunning)

    def _read(self) -> None:
        if self._proc is None:
            return
        data = bytes(self._proc.readAll()).decode("utf-8", "replace")
        if not data:
            return
        self._set_status(tr("Running…"), ui.DIM)
        self._log.moveCursor(QTextCursor.End)
        self._log.insertPlainText(data)
        self._log.moveCursor(QTextCursor.End)
        sb = self._log.verticalScrollBar()
        sb.setValue(sb.maximum())

    def _error(self, err) -> None:
        # FailedToStart never emits finished(), which used to leave the overlay
        # up with its Close button disabled and Esc blocked — a dead window.
        if err == QProcess.FailedToStart:
            self._log.append(tr("Could not start pkexec — is polkit installed?"))
            self._done(-1, None)

    def _done(self, code: int, _status) -> None:
        if code in (126, 127):
            # pkexec: 126 = dialog dismissed, 127 = not authorised. Nothing ran.
            self._log.append("\n" + tr("Authorisation was cancelled or denied — "
                                       "nothing was changed."))
            self._set_status(tr("Cancelled."), ui.DIM)
            self._spinner.stop("idle")
        elif code == 0:
            self._set_status(tr("Completed successfully."), ui.OK_GREEN)
            self._spinner.stop("ok")
        else:
            self._set_status(tr("Finished with errors."), ui.BAD_RED)
            self._spinner.stop("fail")
        self._close.setEnabled(True)
        self._close.setFocus()


class KernelSwitcher(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self._drag_offset: QPoint | None = None
        self.setWindowTitle("Maze Kernel Switcher")
        self.setWindowIcon(QIcon(APP_ICON))
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowSystemMenuHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        # The kernel list scrolls, so on a short screen (1366x768) the window
        # shrinks to fit instead of pushing its footer off the bottom edge.
        self.setFixedSize(WIN_W, ui.fit_height(WIN_H))

        self._root = ui.GlassWindow(self, ui.make_watermark())
        self._root.setGeometry(0, 0, self.width(), self.height())
        self._outer = QVBoxLayout(self._root)
        self._outer.setContentsMargins(28, 22, 28, 22)
        self._outer.setSpacing(0)
        self._build()

        self._runner = RunPanel(self, self._refresh)

    # -- build / rebuild ------------------------------------------------------
    def _build(self) -> None:
        self._clear_layout(self._outer)
        running = running_pkgbase()
        installed = installed_versions()
        default, pinned = default_pkgbase()
        self._outer.addLayout(ui.app_header(
            APP_ICON, "MAZE KERNEL", tr("Kernel Switcher"),
            self._set_language, self.close, self.devicePixelRatioF()))
        self._outer.addSpacing(20)
        self._outer.addWidget(self._summary(running, default, pinned))
        self._outer.addSpacing(22)
        count = ui.label(tr("{n} installed").format(n=len(installed)), 8, ui.FAINT,
                         QFont.DemiBold, 0.6)
        self._outer.addLayout(ui.section_label(tr("Kernels"), count))
        self._outer.addSpacing(10)
        self._outer.addWidget(self._list(running, installed, default, pinned), 1)
        self._outer.addSpacing(14)
        self._outer.addLayout(self._footer())

    @classmethod
    def _clear_layout(cls, lay) -> None:
        # Recursive: the header nests its title column inside the bar, and a
        # non-recursive clear left those labels painted under the new ones —
        # a doubled title after every refresh or language switch.
        while lay.count():
            it = lay.takeAt(0)
            w = it.widget()
            if w is not None:
                w.setParent(None)
                w.deleteLater()
            elif it.layout() is not None:
                cls._clear_layout(it.layout())
                it.layout().deleteLater()

    @staticmethod
    def _summary_half(caption: str, color: str, pkg: str | None, detail: str,
                      running: bool) -> QHBoxLayout:
        meta = kernel_meta(pkg or "")
        lay = QHBoxLayout()
        lay.setSpacing(16)
        tile = ui.IconTile(kernel_icon(meta), 60)
        tile.set_state(dot=QColor(ui.OK_GREEN) if running else None)
        lay.addWidget(tile, 0, Qt.AlignVCenter)
        col = QVBoxLayout()
        col.setSpacing(4)
        col.addStretch(1)
        chip_row = QHBoxLayout()
        chip_row.addWidget(ui.chip(ui.caps(caption), color))
        chip_row.addStretch(1)
        col.addLayout(chip_row)
        col.addWidget(ui.label(meta["name"] if meta else (pkg or tr("unknown")),
                               15, ui.TEXT, QFont.Bold))
        det = QLabel(detail)
        det.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        det.setFont(QFont(ui.MONO, 8))
        col.addWidget(det)
        col.addStretch(1)
        lay.addLayout(col, 1)
        return lay

    def _summary(self, running: str, default: str | None, pinned: bool) -> QWidget:
        """Two halves: what runs now, and what the next boot will run."""
        card = ui.GlassCard(radius=14)
        lay = QHBoxLayout(card)
        lay.setContentsMargins(20, 18, 22, 18)
        lay.setSpacing(12)
        lay.addLayout(self._summary_half(
            tr("Currently running"), ui.OK_GREEN, running, os.uname().release,
            True), 1)
        lay.addWidget(FlowArrow(), 0, Qt.AlignVCenter)
        lay.addSpacing(6)
        mode = tr("pinned by you") if pinned else tr("automatic: newest installed")
        lay.addLayout(self._summary_half(
            tr("Boots next"), "#ffffff", default, mode, default == running), 1)
        if pinned:
            auto = ui.pill_button(tr("Use newest"), "ghost")
            auto.setToolTip(tr("Clear the pinned default ({pkg}); the newest "
                               "installed kernel will boot from now on."
                               ).format(pkg=default))
            auto.clicked.connect(lambda: self._action("clear-default", ""))
            lay.addWidget(auto, 0, Qt.AlignVCenter)
        return card

    def _list(self, running: str, installed: dict[str, str],
              default: str | None, pinned: bool) -> QWidget:
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        scroll.setStyleSheet("""
            QScrollArea { background: transparent; border: none; }
            QScrollArea > QWidget > QWidget { background: transparent; }
            QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
            QScrollBar::handle:vertical { background: rgba(255,255,255,0.18);
                                          border-radius: 4px; min-height: 32px; }
            QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.32); }
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
            QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
        """)
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        col = QVBoxLayout(inner)
        col.setContentsMargins(0, 0, 0, 0)
        col.setSpacing(10)
        for meta in KERNELS:
            col.addWidget(KernelCard(meta, running, installed, default,
                                     pinned, self._action))
        col.addStretch(1)
        scroll.setWidget(inner)
        return scroll

    def _footer(self) -> QHBoxLayout:
        f = QHBoxLayout()
        f.setContentsMargins(6, 0, 0, 0)
        f.setSpacing(10)
        f.addWidget(ui.label("ⓘ", 11, ui.FAINT, QFont.Bold), 0, Qt.AlignTop)
        hint = ui.label(tr(
            "Installing a kernel builds and signs a Secure-Boot image "
            "automatically. Keep your system updated with pacman -Syu."), 9, ui.FAINT)
        hint.setWordWrap(True)
        f.addWidget(hint, 1)
        f.addSpacing(12)
        refresh = ui.pill_button(tr("Refresh"), "ghost",
                                 ui.themed_pixmap(("view-refresh",), 16))
        refresh.clicked.connect(self._refresh)
        f.addWidget(refresh, 0, Qt.AlignVCenter)
        return f

    # -- actions --------------------------------------------------------------
    def _action(self, verb: str, pkg: str) -> None:
        self._runner.start(verb, pkg)

    def _refresh(self) -> None:
        self._build()

    def _set_language(self, code: str) -> None:
        set_language(code)
        self._build()

    # -- window behaviour -----------------------------------------------------
    def show_centered(self) -> None:
        screen = QApplication.primaryScreen().availableGeometry()
        geo = self.frameGeometry()
        geo.moveCenter(screen.center())
        self.move(geo.topLeft())
        self.show()
        ui.enable_kde_blur(int(self.winId()), ui.blur_region(
            self.width(), self.height(), self.devicePixelRatioF()))

    def resizeEvent(self, event) -> None:  # noqa: N802
        if getattr(self, "_runner", None) is not None and self._runner.isVisible():
            self._runner.resize(self.size())
        super().resizeEvent(event)

    def mousePressEvent(self, event) -> None:  # noqa: N802
        if event.button() == Qt.LeftButton and event.position().y() < 80:
            self._drag_offset = event.globalPosition().toPoint() - self.pos()

    def mouseMoveEvent(self, event) -> None:  # noqa: N802
        if self._drag_offset is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self._drag_offset)

    def mouseReleaseEvent(self, event) -> None:  # noqa: N802
        self._drag_offset = None

    def closeEvent(self, event) -> None:  # noqa: N802
        # Alt+F4 / the taskbar would otherwise close us mid-transaction: the
        # helper's stdout pipe breaks and pacman can die on SIGPIPE halfway
        # through installing a kernel.
        if self._runner.busy():
            event.ignore()
            return
        super().closeEvent(event)

    def keyPressEvent(self, event) -> None:  # noqa: N802
        if event.key() == Qt.Key_Escape:
            if self._runner.isVisible():
                return  # don't let Esc close the window mid-operation
            self.close()
            return
        super().keyPressEvent(event)


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Maze Kernel Switcher")
    app.setDesktopFileName("maze-kernel")
    app.setWindowIcon(QIcon(APP_ICON))
    win = KernelSwitcher()
    win.show_centered()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
