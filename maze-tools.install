# maze-tools.install — make the shipped services "ready out of the box".
#
# A pacman package may not enable services from PKGBUILD, so enablement lives
# here. On install we apply the package's systemd preset for the shipped units.
# (MAC randomisation is NOT handled here anymore — it is owned exclusively by
# maze-guard; the old mac-changer service/udev rule was removed.)
#
# `systemctl enable` works offline (in the mkarchiso chroot it just creates the
# wants symlinks); `systemctl start` is guarded so it is skipped when no live
# systemd is running (image build).

_units="maze-switchd.service maze-flatpak-setup.service maze-sentinel.service maze-sentinel-setup.service"

# Services safe to start immediately on a live install (no network flap).
_start_now="maze-switchd.service maze-sentinel-setup.service maze-sentinel.service"

_reload_udev() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
    fi
}

# OpenSnitch left Maze in 2026-10. Machines installed before that run its daemon
# in the passive allow-all mode Maze shipped, with a tray icon autostarted from
# every home. Retire that ONCE: stop the daemon and drop the Maze-seeded tray
# autostart — but only while the daemon is still in that passive mode. Anyone who
# switched it to deny is actually using OpenSnitch, and is left alone.
#
# A scriptlet runs under pacman's lock and cannot uninstall a package, so the
# opensnitch package itself stays; maze-audit points at `pacman -Rns opensnitch`.
_OPENSNITCH_MARKER=/var/lib/maze/opensnitch-retired
# sha256 of opensnitch_ui.desktop as every maze-plasma-config <= 1.2.1-8 seeded it.
_OPENSNITCH_UI_SHA256=7bb732c78bcc9fbf6581dd26e6de8276780d3193f0d82726b5f6c808ecd3b58e

_retire_opensnitch() {
    [ -e "$_OPENSNITCH_MARKER" ] && return 0
    _cfg=/etc/opensnitchd/default-config.json
    if [ -f "$_cfg" ] && ! grep -Eq '"DefaultAction"[[:space:]]*:[[:space:]]*"allow"' "$_cfg"; then
        echo ">> maze-tools: OpenSnitch is no longer part of Maze; yours is in active use, so it is left as is."
    else
        systemctl disable opensnitchd.service >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl stop opensnitchd.service >/dev/null 2>&1 || true
        fi
        for _f in /home/*/.config/autostart/opensnitch_ui.desktop; do
            [ -f "$_f" ] || continue
            [ "$(sha256sum "$_f" | cut -d' ' -f1)" = "$_OPENSNITCH_UI_SHA256" ] && rm -f "$_f"
        done
        if command -v opensnitchd >/dev/null 2>&1; then
            echo ">> maze-tools: OpenSnitch is no longer part of Maze — its daemon is stopped and disabled."
            echo "   Remove the package with: sudo pacman -Rns opensnitch"
        fi
    fi
    mkdir -p "${_OPENSNITCH_MARKER%/*}" && : > "$_OPENSNITCH_MARKER"
}

# maze-guardd became maze-switchd in 2.2.0 (the "guard" name read as part of
# the unrelated Maze Guard package). pacman has already removed the old unit
# file, so carry the admin's choice over by hand: the old wants/ symlink means
# it was enabled, a drop-in directory means it was customised. The old daemon
# keeps running from its deleted file until stopped, holding guard.sock.
_migrate_guardd() {
    _old=maze-guardd.service
    _new=maze-switchd.service
    _was_enabled=0
    if [ -L "/etc/systemd/system/multi-user.target.wants/$_old" ]; then
        rm -f "/etc/systemd/system/multi-user.target.wants/$_old"
        _was_enabled=1
    fi
    if [ -d "/etc/systemd/system/$_old.d" ] && [ ! -e "/etc/systemd/system/$_new.d" ]; then
        mv "/etc/systemd/system/$_old.d" "/etc/systemd/system/$_new.d"
        echo ">> maze-tools: moved your maze-guardd drop-ins to /etc/systemd/system/$_new.d"
    fi
    [ "$_was_enabled" -eq 1 ] || return 0
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable "$_new" >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl stop "$_old" >/dev/null 2>&1 || true
        rm -f /run/maze/guard.sock
        systemctl start "$_new" >/dev/null 2>&1 || true
    fi
    echo ">> maze-tools: maze-guardd is now maze-switchd (panic + kill switches; not part of Maze Guard)."
}

post_install() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Honour the shipped preset (90-maze-tools.preset) for our units.
    systemctl preset $_units >/dev/null 2>&1 || \
        systemctl enable $_units >/dev/null 2>&1 || true
    _reload_udev
    # Start the safe services now if a real system is up (no netdrop).
    if [ -d /run/systemd/system ]; then
        systemctl start $_start_now >/dev/null 2>&1 || true
    fi
    echo ">> maze-tools: services enabled."
}

post_upgrade() {
    # Pick up unit/rule changes, but do NOT re-enable — respect the admin's
    # choices across upgrades.
    systemctl daemon-reload >/dev/null 2>&1 || true
    _reload_udev
    # maze-switchd is a long-running Python process: without a restart it keeps
    # executing the OLD code until the next reboot, so a fixed kill switch or
    # panic would not actually be fixed. try-restart leaves a disabled/stopped
    # daemon alone; the socket is recreated within a second.
    if [ -d /run/systemd/system ]; then
        systemctl try-restart maze-switchd.service >/dev/null 2>&1 || true
    fi
    _migrate_guardd
    _retire_opensnitch
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    _reload_udev

    # Re-enable the camera if the killswitch had disabled it.
    #
    # The switch works by blacklisting uvcvideo in modprobe.d, which survives a
    # reboot on purpose. Removing this package takes away the only tool that can
    # undo it, so leaving the file behind means a camera that is dead for good
    # with nothing left to explain why. maze-secureboot clears its own
    # boot-unsafe flag on removal for the same reason.
    if [ -e /etc/modprobe.d/maze-killswitch-camera.conf ]; then
        rm -f /etc/modprobe.d/maze-killswitch-camera.conf
        modprobe uvcvideo >/dev/null 2>&1 || true
        echo ">> maze-tools: camera killswitch removed - the camera works again."
    fi
}
